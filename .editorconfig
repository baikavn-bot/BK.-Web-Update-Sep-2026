# Quy ước chung cho mọi trình soạn thảo (VS Code, Cursor, agent…)
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown dùng 2 dấu cách cuối dòng để xuống dòng — không tự xoá
trim_trailing_whitespace = false
