# Biến môi trường cho form Liên hệ.
# ⛔ File này CHỈ ghi TÊN biến. Không bao giờ ghi giá trị thật vào đây —
#    nó nằm trong Git. Giá trị thật đặt ở: Vercel → Settings →
#    Environment Variables.

# Khoá API của Resend (resend.com). Bắt đầu bằng "re_".
RESEND_API_KEY=

# Địa chỉ nhận thư liên hệ.
CONTACT_TO=

# Địa chỉ đứng tên gửi. Phải thuộc tên miền đã xác minh trên Resend.
# Chưa xác minh xong thì tạm dùng onboarding@resend.dev
CONTACT_FROM=
