---
// Icon mũi tên chéo lên phải — Lucide `arrow-up-right`.
// Vẽ thẳng bằng SVG thay vì file ảnh: nhẹ hơn, sắc nét ở mọi cỡ màn,
// và đổi màu được bằng CSS qua `currentColor`.
interface Props {
  /** Cỡ icon tính bằng px. Mặc định 24 — đúng cỡ trong Figma. */
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M7 7h10v10" />
  <path d="M7 17 17 7" />
</svg>
