---
// SECTION 4 — "BẠN SẼ NHẬN ĐƯỢC GÌ"
// Figma: Desktop 382:8879 · Tablet 480:2096 · Mobile 450:5602. Đo 25/09/2026.
//
// Chiều cao: 1098 (desktop) · **1098 (tablet — y hệt desktop)** · 1592 (mobile)
//
// Đây là section giàu hình nhất của cả trang: **6 mái vòm treo lơ lửng**
// trên những sợi dây sáng, xếp thành tháp 3–2–1, dưới một vòng cung hành
// tinh khổng lồ. Mỗi vòm chứa một kết quả khách nhận được.
//
// ─── Vì sao section này KHÔNG có auto-layout ─────────────────────────
// Sáu vòm nằm ở sáu vị trí tự do, mỗi sợi dây một độ dài khác nhau
// (207 · 140 · 208 · 371 · 218 · 364). Đó là bố cục đặt tay, không phải
// lưới. Nên ở đây cũng đặt tuyệt đối theo đúng toạ độ Figma, thay vì cố
// ép vào flex/grid rồi ra hình khác.
//
// ─── Số đo (toạ độ trong khung nội dung 1200×788) ────────────────────
//   Ba hàng vòm ở y = 200 · 404 · 608, mỗi hàng cao 180
//   Hàng 1: 3 vòm 360, cách 48 → tâm ở x = 192 · 600 · 1008
//   Hàng 2: 2 vòm 360, cách 87 → tâm ở x = 376.5 · 823.5
//   Hàng 3: 1 vòm 360         → tâm ở x = 600
//   Sáu sợi dây rơi đúng vào tâm từng vòm (lệch ≤ 2px, làm tròn).
//
// Sợi dây gồm HAI nét chồng nhau — đúng cách vẽ dây phát sáng:
//   nét 3px blur 4 tạo quầng · nét 1px blur 1 tạo lõi
//   cả hai tô gradient dọc: trong suốt ở trên → sáng ở dưới, nên dây mờ
//   dần về phía "trần" và rõ nhất ở chỗ chạm vòm.
//
// ─── ✅ ĐÃ ĐO CẢ TABLET VÀ MOBILE 25/09 — sửa lại bản suy luận sai ────
//   Tablet 768 (cao **1098**, y hệt desktop): **2 vòm mỗi hàng × 3 hàng**,
//     cách nhau 24, vẫn giữ nguyên ba mốc y = 200 · 404 · 608.
//     Chỉ còn **2 sợi dây**, treo hai vòm hàng đầu.
//   Mobile 375 (cao 1592): **một cột**, 6 vòm, cách nhau 12.
//     Chỉ còn **1 sợi dây** trên vòm đầu tiên.
//
//   Bản trước em đoán "tablet thì xếp một cột" → ra 1445 thay vì 1098,
//   lệch 347px. Đây là lý do phải đo chứ không suy: bản vẽ giữ nguyên
//   ba hàng ở tablet, chỉ đổi số vòm mỗi hàng.
import FooterHalfCircle from './FooterHalfCircle.astro';

interface Props {
  heading?: string;
  /** Đúng 6 kết quả — bản vẽ 7 trang đều 6 vòm. */
  items: string[];
}
const { heading = 'Bạn sẽ nhận được gì', items } = Astro.props;

// Toạ độ lấy thẳng từ Figma, quy về phần trăm khung 1200×788 để khối co
// giãn đúng tỉ lệ thay vì vỡ khi khung hẹp hơn 1200 một chút.
const VOM = [
  { x: 192,   y: 200 }, { x: 600,   y: 200 }, { x: 1008, y: 200 },
  { x: 376.5, y: 404 }, { x: 823.5, y: 404 },
  { x: 600,   y: 608 },
];
// [tâm x, y bắt đầu, y kết thúc] — độ dài mỗi sợi mỗi khác, cố ý
const DAY = [
  [190, 1, 208], [594, 68, 208], [1006, 0, 208],
  [822, 46, 417], [598, 404, 622], [375, 53, 417],
];
const pc = (v: number, tong: number) => `${(v / tong * 100).toFixed(3)}%`;

// ⚠️ Toạ độ truyền xuống bằng **biến CSS** (`--x`, `--y`, `--cao`), KHÔNG
//    gán thẳng `left`/`top`. Đây đúng là bài học đã ghi ở DEC-060.
//    Lần này lỗi biểu hiện khác: dưới 1280 các vòm nằm trong lưới và để
//    `position: relative`; `left`/`top` gán thẳng khi đó **đẩy lệch** vòm
//    khỏi ô lưới của nó — hai vòm hàng đầu bị đẩy ra ngoài và cắt cụt.
//    Truyền bằng biến thì CSS chỉ đọc nó ở đúng khổ màn cần, các khổ khác
//    bỏ qua — không phải viết một dòng `!important` nào.
---

<section class="nhan sec sec--cat">
  {/* --- Hoạ tiết --- */}
  <div class="nhan__quang" aria-hidden="true"></div>
  <div class="nhan__cung" aria-hidden="true"><span class="nhan__cau"></span></div>

  <h2 class="nhan__heading">{heading}</h2>

  <div class="nhan__khung">
    {/* Sáu sợi dây. Đặt trước các vòm để vòm vẽ đè lên đầu dây. */}
    {DAY.map(([x, y1, y2]) => (
      <span
        class="nhan__day"
        aria-hidden="true"
        style={`--x:${pc(x, 1200)}; --y:${pc(y1, 788)}; --cao:${pc(y2 - y1, 788)}`}
      ></span>
    ))}

    {items.slice(0, 6).map((text, i) => (
      <div
        class="nhan__vom"
        style={`--x:${pc(VOM[i].x, 1200)}; --y:${pc(VOM[i].y, 788)}`}
      >
        <FooterHalfCircle width="360px" />
        <p class="nhan__chu">{text}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .nhan {
    padding-block: var(--s-20) 0;      /* Figma: tiêu đề ở y=80 */
  }

  /* Khoảng chừa dưới khung vòm — đo được: **101 ở desktop và tablet,
     0 ở mobile**. Thang spacing không có bậc 101; lấy 96 (--s-24).
     Mobile để 0 vì bản vẽ cho vòm cuối chạm đúng đáy section. */
  @media (min-width: 768px) {
    .nhan { padding-bottom: var(--s-24); }
  }

  /* --- Quầng sáng ấm phía dưới ----------------------------------------
     Figma `Vector 6`: 1708×519 ở (−215, 549), gradient toả tròn
     `--page-*-nhat` → `--gray-950`, blur 500.
     Màu lấy từ **màu trụ** nên sang trang khác tự đổi, không sửa gì. */
  .nhan__quang {
    position: absolute;
    left: 50%;
    top: 549px;
    z-index: 0;
    width: 1708px;
    height: 519px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      50% 50% at 50% 50%,
      var(--tru-nhat) 0%,
      color-mix(in srgb, var(--gray-950) 0%, transparent) 100%
    );
    filter: blur(var(--blur-500));     /* Figma LayerBlur 500 → CSS 250 */
    pointer-events: none;
  }

  /* --- Vòng cung hành tinh --------------------------------------------
     Figma `Ellipse 11`: 1920×727 ở y=277, cùng một cách dựng với vòng cung
     ở Hero — chỉ khác lớp sáng để **0.10** thay vì 0.15 (đã kiểm từng lớp,
     xem DEC-094 về chuyện độ đục của lớp tô). */
  .nhan__cung {
    position: absolute;
    top: 277px;
    left: 50%;
    width: max(150%, 1920px);
    aspect-ratio: 1920 / 727;
    transform: translateX(-50%);
    z-index: 0;
    pointer-events: none;
  }
  .nhan__cau {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--gray-50) 10%, transparent) 0%,
        color-mix(in srgb, var(--gray-950) 0%, transparent) 33%
      ),
      var(--gray-950);
    box-shadow:
      inset 0 24px 60px 0 color-mix(in srgb, var(--gray-50) 25%, transparent),
      0 -103px 60px 0 color-mix(in srgb, var(--gray-50) 7%, transparent);
  }
  /* Nét viền sáng 4px ở mép trên — cùng kỹ thuật với FaqItem/PricingCard. */
  .nhan__cau::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 4px;
    background: linear-gradient(
      180deg,
      var(--gray-50) 0%,
      color-mix(in srgb, var(--gray-50) 0%, transparent) 26%
    );
    -webkit-mask:
      linear-gradient(var(--gray-950) 0 0) content-box,
      linear-gradient(var(--gray-950) 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }
  @supports not ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
    .nhan__cau::before { display: none; }
  }

  /* --- Tiêu đề --------------------------------------------------------- */
  .nhan__heading {
    position: relative;
    z-index: 2;
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--fs-h1);
    line-height: var(--lh-h1);
    font-weight: var(--fw-h1);
    color: var(--gray-50);
    text-align: center;
  }

  /* --- Khung chứa vòm --------------------------------------------------
     Mobile: một cột, 6 vòm, cách nhau 12. Một sợi dây trên vòm đầu. */
  .nhan__khung {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    gap: var(--s-3);                   /* 12 */
    margin-top: 92px;                  /* tiêu đề y=80 + cao 37 → khung y=209 */
    padding-top: 200px;                /* ba hàng vòm bắt đầu ở y=200 */
    /* Khung vòm CHẠY HẾT bề ngang section, không chừa lề trang —
       đo được: tablet khung rộng đúng 768 (x=0), mobile 375 (x=1).
       Kéo ngược lại đúng bằng lề trang để thoát ra.
       Thiếu dòng này thì hai vòm 360 + khoảng cách 24 = 744 không vừa
       khung 688, và vòm bên phải bị cắt cụt — đã thấy thật khi chụp. */
    margin-inline: calc(var(--le-trang) * -1);
  }

  .nhan__vom {
    position: relative;
    width: min(360px, 100%);
  }

  /* Sợi dây: hai nét chồng nhau — nét ngoài 3px mờ nhiều tạo quầng, nét
     trong 1px mờ ít tạo lõi sáng. Gradient dọc: trong suốt ở trên, sáng
     dần xuống dưới, nên dây mờ ở "trần" và rõ nhất ở chỗ chạm vòm. */
  .nhan__day {
    display: none;
    position: absolute;
    width: 3px;
    transform: translateX(-1.5px);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--gray-600) 0%, transparent) 0%,
      var(--gray-100) 100%
    );
    filter: blur(2px);                 /* Figma LayerBlur 4 → CSS 2 */
    pointer-events: none;
  }
  .nhan__day::after {
    content: '';
    position: absolute;
    inset: 0 1px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--gray-600) 0%, transparent) 0%,
      var(--gray-50) 100%
    );
    filter: blur(0.5px);               /* Figma LayerBlur 1 → CSS 0.5 */
  }

  /* Mobile: đúng MỘT sợi, trên vòm đầu tiên. Figma: cao 141, từ y=67. */
  .nhan__day:first-child {
    display: block;
    left: 50%;
    top: 67px;
    height: 141px;
  }

  /* --- Tablet: 2 vòm mỗi hàng × 3 hàng, vẫn đúng ba mốc y --------------- */
  @media (min-width: 768px) {
    .nhan__khung {
      grid-template-columns: repeat(2, 360px);
      justify-content: center;
      gap: 24px;                       /* cả hàng lẫn cột */
    }
    /* Hai sợi, treo hai vòm hàng đầu. Figma: cao 152, từ y=54,
       tâm ở x=192 và 576 trên khung 768 → 25% và 75%. */
    .nhan__day:nth-child(-n + 2) {
      display: block;
      top: 54px;
      height: 152px;
    }
    .nhan__day:nth-child(1) { left: 25%; }
    .nhan__day:nth-child(2) { left: 75%; }
  }

  /* Figma: chữ rộng 280 đặt ở (40, 108) trong vòm 360×180 —
     tức nằm ở phần dưới của mái vòm, nơi vòm đã đủ rộng để chứa chữ. */
  .nhan__chu {
    position: absolute;
    left: 11.111%;                     /* 40 / 360 */
    top: 60%;                          /* 108 / 180 */
    width: 77.778%;                    /* 280 / 360 */
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--fs-h3);           /* 19 */
    line-height: var(--lh-h3);
    font-weight: var(--fw-h3);         /* 500 — Medium */
    color: var(--gray-50);
  }

  /* --- Desktop: tháp 3–2–1 đặt theo đúng toạ độ Figma ------------------ */
  @media (min-width: 1280px) {
    .nhan__khung {
      display: block;
      width: 1200px;
      height: 788px;
      margin: 92px auto 0;
      padding-top: 0;
    }
    /* Desktop: đủ 6 sợi, mỗi sợi một vị trí và độ dài riêng. */
    .nhan__day {
      display: block;
      left: var(--x);
      top: var(--y);
      height: var(--cao);
    }

    .nhan__vom {
      position: absolute;
      width: 360px;
      left: var(--x);
      top: var(--y);
      /* Toạ độ Figma là TÂM vòm, nên lùi lại nửa bề ngang. */
      transform: translateX(-180px);
    }

  }
</style>
