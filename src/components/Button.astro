---
import ArrowUpRight from './ArrowUpRight.astro';

// NÚT CHÍNH — hệ `Button 1` (Figma 519:3354, 18 biến thể).
// Đo lại ngày 25/09/2026.
//
// ⚠️ Thắng đã XOÁ lớp `Button Background` (khung trang trí thò xuống dưới,
//    viền 0.5px + 4 ô vuông ở góc). Mỗi biến thể giờ chỉ còn `Button Content`.
//    Hai màu lạc token #CCCCCC và #1237C3 theo đó cũng biến mất khỏi hệ.
//
// Số đo theo cỡ (đã xác minh):
//   Sm : cao 34 · chữ 14 · icon 18
//   Md : cao 36 · chữ 16 · icon 20
//   Lg : cao 44 · chữ 18 · icon 24
//   Chung: padding trái 16 · phải 10 · khoảng cách chữ↔icon 12 · bo góc 0
interface Props {
  /** Chữ trên nút. Figma viết HOA toàn bộ — chỗ dùng cứ viết thường. */
  label: string;
  /** Đích đến. Có href thì render <a>, không có thì render <button>. */
  href?: string;
  /**
   * Khớp trục `Type` trong Figma.
   *
   * ⚠️ Trục `Type` của Button 1 KHÔNG phải trục "cỡ tuỳ chọn" — nó là trục
   * BREAKPOINT, giống mọi component khác trong file (Footer, NVG header,
   * ServiceLinkCard…). Bằng chứng: trang Home trong Figma có đúng 3 instance
   * Button 1 — Lg ở Desktop, Md ở Tablet, Sm ở Mobile.
   *
   * → Dùng `auto` ở mọi chỗ thật. Ba giá trị cố định chỉ để dựng style guide.
   */
  size?: 'auto' | 'sm' | 'md' | 'lg';
  /** Hiện mũi tên bên phải. */
  icon?: boolean;
  /** Chỉ dùng được khi KHÔNG có href (thẻ <a> không có trạng thái disabled). */
  disabled?: boolean;
}
const { label, href, size = 'auto', icon = true, disabled = false } = Astro.props;
const Tag = href && !disabled ? 'a' : 'button';
// Cỡ icon thật do CSS quyết (biến --btn-icon) để `auto` đổi được theo breakpoint.
// Số dưới đây chỉ là width/height viết sẵn trong HTML, tránh nhảy layout lúc tải.
const iconSize = { auto: 24, sm: 18, md: 20, lg: 24 }[size];
---

<Tag
  class:list={['btn', `btn--${size}`]}
  href={href && !disabled ? href : undefined}
  disabled={Tag === 'button' && disabled ? true : undefined}
>
  <span class="btn__label">{label}</span>
  {icon && <span class="btn__icon"><ArrowUpRight size={iconSize} /></span>}
</Tag>

<style>
  .btn {
    /* ⚠️ #000000 CHƯA CÓ TRONG BỘ TOKEN — đo thẳng từ Figma.
       `--gray-950` là #1E1E1E, không phải đen tuyệt đối.
       Chờ Thắng quyết: thêm biến vào Figma, hay nắn về --gray-950.
       (Hai màu lạc token còn lại đã hết hiệu lực từ khi xoá Button Background.) */
    --btn-text: #000000;

    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: var(--btn-h);
    padding-left: var(--s-4);   /* 16 */
    padding-right: 10px;
    background: var(--gray-50);
    border: none;
    border-radius: 0;           /* Button 1 KHÔNG bo góc */
    color: var(--btn-text);
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: box-shadow 120ms ease, background-color 120ms ease;
  }

  /* --- Cỡ ------------------------------------------------------------
     Ba bậc cố định — chỉ dùng khi cần ép một cỡ (ví dụ style guide). */
  .btn--sm { --btn-h: 34px; --btn-fs: 14px; --btn-icon: 18px; }
  .btn--md { --btn-h: 36px; --btn-fs: 16px; --btn-icon: 20px; }
  .btn--lg { --btn-h: 44px; --btn-fs: 18px; --btn-icon: 24px; }

  /* `auto` — đổi theo breakpoint, đúng cách Figma dùng trục Type.
     Mobile → Sm · Tablet → Md · Desktop → Lg. */
  .btn--auto { --btn-h: 34px; --btn-fs: 14px; --btn-icon: 18px; }
  @media (min-width: 768px) {
    .btn--auto { --btn-h: 36px; --btn-fs: 16px; --btn-icon: 20px; }
  }
  @media (min-width: 1280px) {
    .btn--auto { --btn-h: 44px; --btn-fs: 18px; --btn-icon: 24px; }
  }

  .btn__label {
    font-family: var(--font-heading);   /* Chakra Petch */
    font-weight: 600;                   /* SemiBold */
    /* ⚠️ 14/16/18px không nằm trong thang chữ 9 bậc (--fs-body 15, --fs-body-lg 17).
       Đây là số đo thật của Button 1. Chờ Thắng chốt: thêm bậc, hay nắn về thang. */
    font-size: var(--btn-fs);
    line-height: 1.25;                  /* Figma: 125% */
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Mũi tên: hộp vuông nền --blue-700, glyph --gray-50.
     SVG viewBox 24 nên glyph (10) và nét (2) tự co theo cỡ hộp. */
  .btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    background: var(--blue-700);
    color: var(--gray-50);
    border-radius: 0;
  }

  /* CSS quyết cỡ icon, không phải thuộc tính width/height trong HTML —
     nhờ vậy `auto` đổi được cỡ theo breakpoint. */
  .btn__icon :global(svg) {
    width: var(--btn-icon);
    height: var(--btn-icon);
    display: block;
  }

  /* --- Trạng thái — ngôn ngữ tương tác chung DEC-014 / DEC-015 -------- */
  .btn:hover  { box-shadow: var(--shadow-inner); }
  .btn:active { box-shadow: var(--shadow-inner-press); }
  .btn:focus-visible {
    outline: none;
    box-shadow: var(--shadow-drop-inner);
  }

  /* Disabled: đổi màu, GIỮ opacity 1 — quy ước của file này.
     Figma: thân --gray-700, chữ --gray-100, mũi tên GIỮ NGUYÊN nền xanh. */
  .btn:disabled {
    cursor: not-allowed;
    background: var(--gray-700);
    color: var(--gray-100);
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn { transition: none; }
  }
</style>
