---
// Ô tick — Figma `Checkbox` 29:2685. Đo lại ngày 25/09/2026.
//
// ⚠️ KHUNG component bo góc 0, nhưng VECTOR bên trong thì CÓ bo góc.
//    Đọc `vectorPaths` ra số thật:
//      hộp  : 15.333 × 15.333 tại (2.5, 2.5) · bo góc **1.9167** (= 12.5%)
//      nét  : 1px, align CENTER, màu --gray-50
//      tick : path 7.583 × 6.417 tại (6.38, 7) · đầu nét bo tròn
//
//    Không dùng `border` của CSS được — border bo góc theo hộp 20×20 chứ
//    không theo hình 15.33 bên trong. Vẽ thẳng bằng SVG mới đúng.
//
//    SVG viết THẲNG TRONG FILE, không tải file .svg rời:
//      · bớt một file phải quản
//      · đổi màu được bằng `currentColor` → một hình dùng chung cho cả
//        Default / Error / Disabled, thay vì ba file khác nhau
//
// Màu theo trạng thái (đã xác minh):
//   Chưa tick : nét --gray-50, trong rỗng
//   Đã tick   : ruột --gray-950, nét + tick --gray-50
//   Error     : nét --red-200 (#FB3748)
//   Disabled  : nét + tick --gray-700
//   Hover     : KHÔNG đổi hình — cố ý. Tín hiệu hover nằm ở nhãn và con trỏ.
interface Props {
  id: string;
  name: string;
  required?: boolean;
}
const { id, name, required = false } = Astro.props;
---

<div class="check" data-field={name}>
  <div class="check__row">
    <span class="check__box">
      <input class="check__input" type="checkbox" id={id} name={name} required={required}
             aria-describedby={`${id}-err`} />
      <svg class="check__svg" viewBox="0 0 20 20" width="20" height="20"
           fill="none" aria-hidden="true" focusable="false">
        <rect
          class="check__frame"
          x="2.5" y="2.5" width="15.333" height="15.333" rx="1.917"
          stroke="currentColor" stroke-width="1" stroke-linejoin="round"
        />
        <path
          class="check__tick"
          d="M13.96 7 L8.66 13.417 L6.38 10.85"
          stroke="currentColor" stroke-width="1"
          stroke-linecap="round" stroke-linejoin="round"
        />
      </svg>
    </span>
    <label class="check__label" for={id}><slot /></label>
  </div>
  <p class="check__hint" id={`${id}-err`} role="alert" hidden></p>
</div>

<style>
  .check { display: flex; flex-direction: column; gap: var(--s-1); }

  .check__row {
    display: flex;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .check__box {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--gray-50);         /* `currentColor` của SVG lấy từ đây */
    border-radius: var(--r-xs);    /* chỉ để quầng sáng Focus ôm gọn */
  }

  /* Ô tick thật — trong suốt, nằm đè lên SVG.
     Giữ <input> thật thay vì vẽ giả: bàn phím, trình đọc màn hình và
     `required` của trình duyệt đều hoạt động sẵn, không phải dựng lại. */
  .check__input {
    position: absolute;
    /* Nới ra 12px mỗi phía = vùng chạm 44×44, đạt WCAG 2.5.8 trên mobile.
       Hình vẫn 20×20, chỉ vùng bấm rộng ra. */
    inset: -12px;
    width: 44px;
    height: 44px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .check__svg { display: block; pointer-events: none; }

  .check__tick { opacity: 0; }

  .check__input:checked ~ .check__svg .check__frame { fill: var(--gray-950); }
  .check__input:checked ~ .check__svg .check__tick  { opacity: 1; }

  /* Focus — quầng sáng, đúng ngôn ngữ chung DEC-014.
     `--shadow-drop-inner` gồm một phần inset và một phần quầng ngoài;
     khung này không có nền nên phần inset không hiện, chỉ còn quầng. */
  .check__input:focus-visible ~ .check__svg { outline: none; }
  .check__box:has(.check__input:focus-visible) {
    box-shadow: var(--shadow-drop-inner);
  }

  .check__label {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--gray-50);
    cursor: pointer;
  }

  /* Error — chỉ đổi màu nét, ruột giữ nguyên */
  .check[data-invalid='true'] .check__box { color: var(--red-200); }
  .check[data-invalid='true'] .check__hint { color: var(--red-100); }

  .check__hint {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
  }
  .check__hint[hidden] { display: none; }

  /* Disabled — đổi màu, KHÔNG giảm opacity */
  .check__input:disabled { cursor: not-allowed; }
  .check__box:has(.check__input:disabled) { color: var(--gray-700); }
  .check__input:disabled ~ .check__svg .check__frame { fill: none; }
  .check__input:disabled + .check__svg + .check__label,
  .check__row:has(.check__input:disabled) .check__label {
    color: var(--gray-700);
    cursor: not-allowed;
  }
</style>
