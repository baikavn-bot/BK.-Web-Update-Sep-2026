---
// SECTION "TUYỂN THÊM NGƯỜI HAY GIAO CHO BAIKA?" — khối R6 trang Remote Office
//
// Figma (đọc 01/10/2026):
//   Desktop `922:3801` (trong frame `913:4649`) · Tablet `933:3544` · Mobile `933:4613`
//   Tablet + Mobile là bản ĐỀ XUẤT D1 Thắng duyệt 01/10 — xem
//   docs/remote-office/spec-giao-dien.md §5 và §7.3.
// Chữ: docs/remote-office/spec-noi-dung.md §6 (L8 · L9 · L10 · L20 đã chốt).
//
// ─── Hai dạng, MỘT bảng ──────────────────────────────────────────────────
//   ≥ 768  : bảng 3 cột — tiêu chí · tự tuyển · BAIKA (cột BAIKA nền sáng, bên PHẢI)
//   < 768  : MỖI TIÊU CHÍ MỘT KHỐI — tên tiêu chí → «Tự tuyển · …» → «BAIKA · …»
//
// Vì sao không làm hai bản HTML rồi ẩn một: chữ chỉ nằm ở MỘT chỗ, sửa một lần
// là đúng cả hai khổ. Ở mobile chỉ đổi `display` của chính các ô bảng.
// Chữ «Tự tuyển · » / «BAIKA · » ở mobile là CHỮ THẬT trong HTML (không phải
// `content:` của CSS) — trình đọc màn hình nào cũng đọc được.
//
// ─── Component Figma `Table Item` `842:7837` ─────────────────────────────
//   Desktop/Tablet: padding `--s-4` / `--s-6` · Mobile: padding `--s-4` / `--s-4`
//   Default: viền 1px `--gray-900` · Light: nền `--opacity-white`, không viền
//   Head: bo `--r-sm` hai góc trên · Foot: bo `--r-sm` hai góc dưới
//   Head → chữ H-3 · Body / Foot → chữ body · tất cả `--gray-50`
//
// ⏸ CHỜ CHỐT (SPEC-MASTER §7 #16): ô Desktop/Tablet trong Figma cao CỐ ĐỊNH 66px
//   — ngoài thang khoảng cách. Code để ô cao theo nội dung (padding `--s-4`),
//   ô một dòng thấp hơn Figma ~14px. Chưa có quyết định thì không tự đặt 66.

interface Props {
  heading?: string;
  /** Đầu hai cột so sánh — cột phải luôn là BAIKA. */
  cot?: { tuTuyen: string; baika: string };
  /** Mỗi hàng: tiêu chí · bên tự tuyển · bên BAIKA. */
  hang: { tieuChi: string; tuTuyen: string; baika: string }[];
  /** Chú thích dưới bảng. Bỏ trống thì không hiện. */
  note?: string;
}
const {
  heading = 'Tuyển thêm người hay giao cho BAIKA?',
  cot = { tuTuyen: 'Tuyển thêm nhân viên', baika: 'BAIKA Remote Office' },
  hang,
  note,
} = Astro.props;
---

<section class="ss sec" aria-labelledby="ss-tieu-de">
  <h2 class="tieu-de-section" id="ss-tieu-de">{heading}</h2>

  <table class="ss__bang">
    <thead>
      <tr>
        {/* Ô góc: Figma không vẽ, nhưng bảng thật cần đủ 3 ô mỗi hàng. */}
        <td class="ss__goc"></td>
        <th scope="col" class="ss__o ss__o--vien ss__o--dau">{cot.tuTuyen}</th>
        <th scope="col" class="ss__o ss__o--sang ss__o--dau">{cot.baika}</th>
      </tr>
    </thead>
    <tbody>
      {hang.map((h, i) => {
        const cuoi = i === hang.length - 1;
        return (
          <tr class="ss__hang">
            <th scope="row" class="ss__o ss__o--vien ss__o--tieu-chi">{h.tieuChi}</th>
            <td class="ss__o ss__o--vien ss__o--tu-tuyen">
              <span class="ss__nhan">Tự tuyển · </span>{h.tuTuyen}
            </td>
            <td class:list={['ss__o ss__o--sang ss__o--baika', { 'ss__o--cuoi': cuoi }]}>
              <span class="ss__nhan">BAIKA · </span>{h.baika}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>

  {note && <p class="ss__ghi-chu">{note}</p>}
</section>

<style>
  .ss {
    display: flex;
    flex-direction: column;
    gap: var(--s-10);                  /* 40 — tiêu đề · bảng · chú thích, cả 3 khổ */
    padding-block: var(--s-20);        /* 80 — cả 3 khổ */
  }

  /* ─── Ô bảng — dùng chung hai dạng ─────────────────────────────── */
  .ss__o {
    padding: var(--s-4);               /* mobile: 16 / 16 */
    text-align: left;
    vertical-align: middle;
    color: var(--gray-50);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-body);
  }
  .ss__o--vien { border: 1px solid var(--gray-900); }
  .ss__o--sang { background: var(--opacity-white); }

  /* Đầu cột (và tên tiêu chí ở mobile) dùng chữ H-3 — đúng `Locate=Head`. */
  .ss__o--dau,
  .ss__o--tieu-chi {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: var(--fw-h3);
  }

  .ss__ghi-chu {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    line-height: var(--lh-caption);
    font-weight: var(--fw-caption);
    color: var(--gray-50);
  }

  /* ─── MOBILE < 768: mỗi tiêu chí một khối ─────────────────────────
     Bảng thôi xếp theo lưới; mỗi hàng `<tr>` thành một khối dọc gồm 3 ô:
       tên tiêu chí  (Head Default — bo hai góc trên)
       Tự tuyển · …  (Body Default)
       BAIKA · …     (Foot Light — bo hai góc dưới)
     Hàng đầu (`thead`) ẩn đi: nhãn đã nằm ngay trong từng ô. */
  @media (max-width: 767px) {
    .ss__bang,
    .ss__bang tbody {
      display: flex;
      flex-direction: column;
      gap: var(--s-3);                 /* 12 — giữa các khối */
    }
    .ss__bang thead { display: none; }
    .ss__hang {
      display: flex;
      flex-direction: column;
      gap: var(--s-1);                 /* 4 — trong một khối */
    }
    .ss__o { display: block; }
    .ss__o--tieu-chi { border-radius: var(--r-sm) var(--r-sm) 0 0; }
    .ss__o--baika { border-radius: 0 0 var(--r-sm) var(--r-sm); }
    /* Nhãn bên: đậm hơn chữ thường một bậc — Figma đề xuất D1 dùng Medium,
       trùng độ đậm của thang H-3 (500). */
    .ss__nhan { font-weight: var(--fw-h3); }
  }

  /* ─── TABLET + DESKTOP ≥ 768: bảng 3 cột ─────────────────────────── */
  @media (min-width: 768px) {
    .ss__bang {
      width: 100%;
      table-layout: fixed;             /* 3 cột bằng nhau, như GRID của Figma */
      border-collapse: separate;
      border-spacing: 0 var(--s-1);    /* 4 giữa các hàng · 0 giữa các cột */
      margin-block: calc(var(--s-1) * -1);  /* bù khoảng thừa trên đầu + dưới chân bảng */
    }
    .ss__nhan { display: none; }
    .ss__o { padding: var(--s-4) var(--s-6); }   /* 16 / 24 */

    /* Tiêu chí ở bảng là chữ body (Body Default), không phải H-3. */
    .ss__o--tieu-chi {
      font-family: var(--font-body);
      font-size: var(--fs-body);
      line-height: var(--lh-body);
      font-weight: var(--fw-body);
    }
    /* Hai ô viền nằm sát nhau: bỏ viền trái ô sau cho khỏi thành vạch 2px
       (Figma viền "giữa" nên chồng lên nhau thành 1px). */
    .ss__o--tu-tuyen { border-left: 0; }

    .ss__o--dau { border-radius: var(--r-sm) var(--r-sm) 0 0; }
    .ss__o--cuoi { border-radius: 0 0 var(--r-sm) var(--r-sm); }
  }
</style>
