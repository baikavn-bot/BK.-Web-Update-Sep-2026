---
// SECTION "ƯỚC TÍNH KHOẢN CHÊNH LỆCH CỦA BẠN" — khối R4 trang Remote Office
//
// Figma (đọc 01/10/2026): Desktop `913:4711` · Tablet `923:4248` · Mobile `922:3630`.
// Chữ: docs/remote-office/spec-noi-dung.md §4 (L6 L7 L15–L19 đã chốt) · §4.5 (chữ trạng thái).
// Bố cục + hành vi: docs/remote-office/spec-giao-dien.md §4 + §7.2.
// PHẦN TÍNH: src/lib/uoc-tinh.ts — mọi tham số ở ĐÓ, file này chỉ vẽ.
//
// ─── Hành vi ────────────────────────────────────────────────────────────
//   Đổi bất kỳ ô nào → tính lại NGAY (không có nút "Tính").
//   Không có JavaScript → vẫn hiện ca mẫu (2 người · 10 triệu · 3 nhóm) đã tính
//   sẵn lúc build, kèm dòng «Bật JavaScript để tính theo số của bạn.»
//
// ─── ✅ Logic tính: sếp chốt 02/10 — theo LOGIC BAN ĐẦU (Spec v3 §13.6–13.7) ─
//   Gói theo SỐ NHÓM việc (1 → Khởi đầu · 2–3 → Vận hành · từ 4 → Trọn gói),
//   1.800.000 chi phí cố định, tick sẵn 3 nhóm theo Spec v3. Chi tiết: uoc-tinh.ts.
//
// ─── ⏸ CHỜ CHỐT ─────────────────────────────────────────────────────────
//   #11 ✅ 04/10: khoảng `--s-3` (12) — Figma đã sửa 10 → 12
//   Lương: chỉ bấm ‹ › (bước 500.000). Gõ tay là đề xuất chưa duyệt — chưa làm.
//
// ─── Ô "Nhóm công việc" — ✅ Thắng chốt #4 ngày 01/10 ────────────────────
//   Figma `Find Job` `854:8113` (đóng / mở) + `Check` `836:7698` (mỗi dòng tick).
//   • 8 nhóm = đúng 8 mục của khối R3 — trang truyền vào qua prop `nhomViec`,
//     chữ chỉ nằm MỘT chỗ (remote-office.astro).
//   • Tick sẵn 3 nhóm theo Spec v3 §13.7 (`THAM_SO.nhomMacDinh`: Hành chính · Nhân sự ·
//     Chăm sóc khách hàng) → trang mở ra có số 18.400.000 đ như Figma.
//   • Mở ra thì ĐẨY nội dung bên dưới xuống (không nổi đè) — mobile không che bảng.
//   • Dùng <details>/<summary> gốc của trình duyệt: mở/đóng chạy cả khi tắt JS,
//     bàn phím (Enter/Space) và trình đọc màn hình hiểu sẵn.
//
// ─── Nút «Gửi yêu cầu theo ước tính này» — ✅ Thắng chốt #6 ngày 01/10 ───
//   Bấm → ĐIỀN SẴN bản tóm tắt ước tính vào ô «Mô tả vấn đề» của form Liên hệ
//   (khối R9, cuối trang) → cuộn xuống → con trỏ đặt vào ô «Tên».
//   Khách thấy, sửa, viết thêm được. Gửi form → API /api/contact gửi mail về
//   hộp thư BAIKA; tiêu đề mail «Yêu cầu theo ước tính» (api/contact.ts, 02/10).
//   Bấm lại sau khi đổi số → thay đoạn ước tính cũ, giữ nguyên chữ khách đã viết.
//   Tắt JS → nút chỉ là đường dẫn #lien-he, cuộn xuống form, không điền sẵn.
import Button2 from './Button2.astro';
import IconChevronDown from './IconChevronDown.astro';
import CheckItem from './CheckItem.astro';
import { THAM_SO, uocTinh, dinhDangTien } from '../lib/uoc-tinh';

interface Props {
  heading?: string;
  /** Tên các nhóm việc cho danh sách tick — trang lấy từ khối R3. */
  nhomViec: string[];
}
const { heading = 'Ước tính khoản chênh lệch của bạn', nhomViec } = Astro.props;

// Ca mẫu — đúng số trên Figma. Vẽ sẵn lúc build để không có JS vẫn đọc được.
const nguoi0 = THAM_SO.soNguoi.macDinh;
const luong0 = THAM_SO.luong.macDinh;
const nhomTick0 = new Set<string>(THAM_SO.nhomMacDinh);
const nhom0 = nhomViec.filter((ten) => nhomTick0.has(ten)).length;
const kq0 = uocTinh(nguoi0, luong0, nhom0);
const tenGoi0 = kq0.goi ? `Gói ${THAM_SO.goi[kq0.goi].ten}` : '-';


const congThuc = 'Chi phí tự tuyển = lương + 21,5% bảo hiểm + 2% kinh phí công đoàn + khoảng 1,8 triệu chỗ ngồi, thiết bị, tuyển dụng.';
const luuY = 'Con số mang tính tham khảo, chưa gồm VAT. Giá chính thức theo báo giá sau buổi khảo sát 45 phút.';
---

<section class="ut sec" id="uoc-tinh" aria-labelledby="ut-tieu-de" data-uoc-tinh>
  <h2 class="tieu-de-section" id="ut-tieu-de">{heading}</h2>

  <div class="ut__khung">
    {/* ─── ĐẦU VÀO ─── */}
    <div class="ut__vao">
      <div class="ut__dong">
        <span class="ut__nhan" id="ut-nhan-nguoi">Số người định tuyển</span>
        <div class="ut__chon" role="group" aria-labelledby="ut-nhan-nguoi">
          <button type="button" class="ut__nut-buoc" data-buoc="nguoi" data-huong="-1" aria-label="Giảm số người">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <output class="ut__gia-tri" data-ra="nguoi" aria-live="polite">{nguoi0}</output>
          <button type="button" class="ut__nut-buoc" data-buoc="nguoi" data-huong="1" aria-label="Tăng số người">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div class="ut__dong">
        <span class="ut__nhan" id="ut-nhan-luong">Lương mỗi người</span>
        <div class="ut__chon" role="group" aria-labelledby="ut-nhan-luong">
          <button type="button" class="ut__nut-buoc" data-buoc="luong" data-huong="-1" aria-label="Giảm lương 500.000 đ">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <output class="ut__gia-tri" data-ra="luong" aria-live="polite">{dinhDangTien(luong0)}</output>
          <button type="button" class="ut__nut-buoc" data-buoc="luong" data-huong="1" aria-label="Tăng lương 500.000 đ">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>

      <div class="ut__dong">
        <span class="ut__nhan" aria-hidden="true">Nhóm công việc</span>
        <details class="ut__nhom" data-vao="nhom">
          <summary class="ut__nhom-o">
            <span><span class="sr-only">Nhóm công việc: </span><span data-ra="so-nhom">{nhom0}</span> nhóm việc</span>
            <span class="ut__mui-ten"><IconChevronDown /></span>
          </summary>
          <fieldset class="ut__nhom-ds">
            <legend class="sr-only">Chọn các nhóm công việc muốn giao cho BAIKA</legend>
            {nhomViec.map((ten) => <CheckItem name="nhom" value={ten} label={ten} checked={nhomTick0.has(ten)} />)}
          </fieldset>
        </details>
      </div>
    </div>

    {/* ─── KẾT QUẢ ─── */}
    <div class="ut__ra">
      <div class="ut__khoi">
        <table class="ut__bang">
          <thead>
            <tr>
              <th scope="col" class="ut__o ut__o--dau">Tự tuyển</th>
              <th scope="col" class="ut__o ut__o--dau">Gói BAIKA</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="ut__o" data-ra="so-nguoi">{nguoi0} người</td>
              <td class="ut__o">
                <span data-ra="ten-goi">{tenGoi0}</span>
              </td>
            </tr>
            <tr>
              <td class="ut__o" data-ra="mot-nguoi">{dinhDangTien(kq0.tuTuyenMotNguoi)}</td>
              <td class="ut__o">-</td>
            </tr>
            <tr>
              <td class="ut__o ut__o--chan" data-ra="tu-tuyen">{dinhDangTien(kq0.tuTuyen)}</td>
              <td class="ut__o ut__o--chan" data-ra="gia-goi">{kq0.giaGoi !== null ? dinhDangTien(kq0.giaGoi) : '-'}</td>
            </tr>
          </tbody>
        </table>

        <p class="ut__chu-thich">{congThuc}</p>
        <hr class="ut__ke" />

        <div class="ut__ket-qua" aria-live="polite">
          <p class="ut__kq-nhan">Ước tính chênh lệch</p>
          <p class="ut__kq-so" data-ra="chenh-thang">{kq0.chenhLechThang !== null ? dinhDangTien(kq0.chenhLechThang) : '—'}</p>
          <p class="ut__kq-nam" data-ra="chenh-nam">{kq0.chenhLechNam !== null ? `≈${dinhDangTien(kq0.chenhLechNam)}/năm` : ''}</p>
          <p class="ut__kq-loi" data-ra="loi" hidden></p>
          <p class="ut__chu-thich">{luuY}</p>
          <noscript><p class="ut__chu-thich">Bật JavaScript để tính theo số của bạn.</p></noscript>
        </div>
      </div>

      <div class="ut__nut">
        <Button2 label="Gửi yêu cầu theo ước tính này" href="#lien-he" size="lg" iconLeft={false} iconRight={false} />
      </div>
    </div>
  </div>
</section>

<script>
  import { THAM_SO, uocTinh, dinhDangTien } from '../lib/uoc-tinh';

  const timGoc = document.querySelector<HTMLElement>('[data-uoc-tinh]');
  if (timGoc) {
    const goc: HTMLElement = timGoc;
    const ra = (ten: string) => goc.querySelector<HTMLElement>(`[data-ra="${ten}"]`)!;
    const oNhom = goc.querySelector<HTMLElement>('[data-vao="nhom"]')!;
    const giaTri: { nguoi: number; luong: number } = { nguoi: THAM_SO.soNguoi.macDinh, luong: THAM_SO.luong.macDinh };

    const CHU_NHO = 'Khối lượng việc bạn chọn còn nhỏ. Giữ người làm trong công ty vẫn rẻ hơn — cứ liên hệ khi cần giao thêm.';
    const CHU_CHUA_CHON = 'Chọn ít nhất một nhóm việc để BAIKA ước tính giúp bạn.';

    function ve() {
      const nhom = oNhom.querySelectorAll('input[name="nhom"]:checked').length;
      const kq = uocTinh(giaTri.nguoi, giaTri.luong, nhom);

      ra('nguoi').textContent = String(giaTri.nguoi);
      ra('luong').textContent = dinhDangTien(giaTri.luong);
      ra('so-nguoi').textContent = `${giaTri.nguoi} người`;
      ra('mot-nguoi').textContent = dinhDangTien(kq.tuTuyenMotNguoi);
      ra('tu-tuyen').textContent = dinhDangTien(kq.tuTuyen);
      ra('so-nhom').textContent = String(nhom);
      ra('ten-goi').textContent = kq.goi ? `Gói ${THAM_SO.goi[kq.goi].ten}` : '-';
      ra('gia-goi').textContent = kq.giaGoi !== null ? dinhDangTien(kq.giaGoi) : '-';

      ra('chenh-thang').textContent = kq.chenhLechThang !== null ? dinhDangTien(kq.chenhLechThang) : '—';
      ra('chenh-nam').textContent = kq.chenhLechNam !== null ? `≈${dinhDangTien(kq.chenhLechNam)}/năm` : '';
      const loi = ra('loi');
      loi.textContent = kq.trangThai === 'khoi-luong-nho' ? CHU_NHO
        : kq.trangThai === 'chua-chon-nhom' ? CHU_CHUA_CHON : '';
      loi.hidden = loi.textContent === '';

      // Nút ‹ › chuyển Disabled khi chạm giới hạn.
      goc.querySelectorAll<HTMLButtonElement>('[data-buoc]').forEach((b) => {
        const loai = b.dataset.buoc as 'nguoi' | 'luong';
        const huong = Number(b.dataset.huong);
        const gioiHan = loai === 'nguoi' ? THAM_SO.soNguoi : THAM_SO.luong;
        b.disabled = huong < 0 ? giaTri[loai] <= gioiHan.min : giaTri[loai] >= gioiHan.max;
      });
    }

    goc.querySelectorAll<HTMLButtonElement>('[data-buoc]').forEach((b) => {
      b.addEventListener('click', () => {
        const loai = b.dataset.buoc as 'nguoi' | 'luong';
        const huong = Number(b.dataset.huong);
        if (loai === 'nguoi') {
          const { min, max } = THAM_SO.soNguoi;
          giaTri.nguoi = Math.min(max, Math.max(min, giaTri.nguoi + huong));
        } else {
          const { min, max, buoc } = THAM_SO.luong;
          giaTri.luong = Math.min(max, Math.max(min, giaTri.luong + huong * buoc));
        }
        ve();
      });
    });
    oNhom.addEventListener('change', ve);

    // ─── #6: điền ước tính vào form Liên hệ ─────────────────────────────
    // Dòng đầu là "dấu mốc": bấm lại thì tìm dấu mốc này để THAY đoạn cũ.
    // ⚠️ api/contact.ts dùng đúng câu này để đặt tiêu đề mail «Yêu cầu theo ước tính» —
    // đổi ở đây thì đổi cả DAU_MOC_UOC_TINH ở đó.
    const DAU_MOC = 'Ước tính từ công cụ trên trang Remote Office:';

    function vanBanUocTinh(): string {
      const chon = Array.from(oNhom.querySelectorAll<HTMLInputElement>('input[name="nhom"]:checked')).map((o) => o.value);
      const kq = uocTinh(giaTri.nguoi, giaTri.luong, chon.length);
      const dong = [
        DAU_MOC,
        `• ${giaTri.nguoi} người · lương ${dinhDangTien(giaTri.luong)}/người`,
        chon.length ? `• ${chon.length} nhóm việc: ${chon.join(', ')}` : '• Chưa chọn nhóm việc',
        `• Tự tuyển ${dinhDangTien(kq.tuTuyen)}/tháng`,
      ];
      if (kq.goi && kq.giaGoi !== null) dong.push(`• Gói ${THAM_SO.goi[kq.goi].ten} ${dinhDangTien(kq.giaGoi)}/tháng`);
      if (kq.chenhLechThang !== null) dong.push(`• Chênh lệch ≈ ${dinhDangTien(kq.chenhLechThang)}/tháng`);
      return dong.join('\n');
    }

    const nutGui = goc.querySelector<HTMLAnchorElement>('.ut__nut a');
    nutGui?.addEventListener('click', (e) => {
      const moTa = document.querySelector<HTMLTextAreaElement>('#lien-he textarea[name="mota"]');
      const ten = document.querySelector<HTMLInputElement>('#lien-he input[name="ten"]');
      const dich = document.getElementById('lien-he');
      if (!moTa || !dich) return;               // không có form → để đường dẫn tự cuộn
      e.preventDefault();

      const moi = vanBanUocTinh();
      const cu = moTa.value;
      if (cu.startsWith(DAU_MOC)) {
        // Thay đoạn ước tính cũ (tới dòng trống đầu tiên), giữ phần khách tự viết.
        const het = cu.indexOf('\n\n');
        moTa.value = moi + (het >= 0 ? cu.slice(het) : '\n\n');
      } else {
        moTa.value = moi + '\n\n' + cu;
      }
      moTa.dispatchEvent(new Event('input', { bubbles: true }));
      moTa.scrollTop = 0;                       // ô dài → cho thấy dòng đầu của ước tính

      const giamChuyenDong = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      dich.scrollIntoView({ behavior: giamChuyenDong ? 'auto' : 'smooth', block: 'start' });
      ten?.focus({ preventScroll: true });
    });
    ve();
  }
</script>

<style>
  .ut {
    /* Nằm LỚP TRÊN section "Bạn sẽ nhận được gì" ngay bên dưới: cái bát úp của
       section đó tràn ngược lên 450px. Thiếu dòng này thì thân bát tối màu đè
       mờ phần kết quả + nút gửi (đã thấy thật khi chụp 01/10). Cùng cách
       ServicesSection làm ở 7 trang dịch vụ. */
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-10);                  /* 40 tablet/mobile · desktop 80 bên dưới */
    padding-block: var(--s-24);        /* 96 — cả 3 khổ */
  }

  .ut__khung { display: flex; flex-direction: column; }

  /* ─── Đầu vào ─────────────────────────────────────────────────── */
  .ut__vao {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);                   /* 12 — mobile: giữa các dòng */
    padding-block: var(--s-4);
  }
  .ut__dong {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);                   /* 4 — mobile: nhãn TRÊN ô */
  }
  .ut__nhan {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-body);
    color: var(--gray-50);
  }

  /* Ô bấm ‹ số › — Figma vẽ tay, chưa là component (spec-giao-dien §8 #4). */
  .ut__chon {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);                   /* 12 — #11 ✅ */
    padding: var(--s-1);
    min-height: calc(var(--s-12) + var(--s-2));   /* 56 — cao như Figma */
    background: var(--opacity-white);
    color: var(--gray-50);
  }
  .ut__gia-tri {
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: var(--fw-h3);
    font-variant-numeric: tabular-nums;
  }
  .ut__nut-buoc {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    /* Vùng chạm ≥ 44px (WCAG) — icon 24 nằm giữa */
    width: calc(var(--s-10) + var(--s-1));
    height: calc(var(--s-10) + var(--s-1));
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    transition: box-shadow 120ms ease;
  }
  .ut__nut-buoc svg { width: var(--s-6); height: var(--s-6); }
  .ut__nut-buoc:hover:not(:disabled) { box-shadow: var(--shadow-inner); }
  .ut__nut-buoc:active:not(:disabled) { box-shadow: var(--shadow-inner-press); }
  .ut__nut-buoc:focus-visible { outline: none; box-shadow: var(--shadow-drop-inner); }
  .ut__nut-buoc:disabled { color: var(--gray-700); cursor: not-allowed; }

  /* Ô "Nhóm công việc" — Figma `Find Job` `854:8113`.
     Đóng: một ô 56 cao như ô ‹ › bên trên. Mở: danh sách tick hiện NGAY DƯỚI,
     đẩy phần bên dưới xuống. */
  .ut__nhom { display: flex; flex-direction: column; gap: var(--s-3); }  /* 12 — #11 ✅ */
  .ut__nhom-o {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    min-height: calc(var(--s-12) + var(--s-2));   /* 56 */
    padding: var(--s-4);
    background: var(--opacity-white);
    color: var(--gray-50);
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: var(--fw-h3);
    cursor: pointer;
    list-style: none;                  /* bỏ hình tam giác mặc định của <summary> */
    transition: box-shadow 120ms ease;
  }
  .ut__nhom-o::-webkit-details-marker { display: none; }
  .ut__nhom-o:hover { box-shadow: var(--shadow-inner); }
  .ut__nhom-o:focus-visible { outline: none; box-shadow: var(--shadow-drop-inner); }
  .ut__mui-ten { display: inline-flex; transition: transform 120ms ease; }
  /* Mở → mũi tên quay lên (Figma: chevron-up) */
  .ut__nhom[open] .ut__mui-ten { transform: rotate(180deg); }

  .ut__nhom-ds {
    display: flex;
    flex-direction: column;            /* Figma `List`: các dòng sát nhau, gap 0 */
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  /* ─── Kết quả ─────────────────────────────────────────────────── */
  .ut__ra {
    display: flex;
    flex-direction: column;
    gap: var(--s-10);                  /* 40 — khối kết quả → nút (desktop 80) */
    padding-block: var(--s-4);
  }
  .ut__khoi {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);                   /* 24 */
  }

  .ut__bang {
    width: 100%;
