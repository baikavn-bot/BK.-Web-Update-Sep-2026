---
// SECTION 1 — HERO. Dùng chung cho cả 7 trang dịch vụ.
// Figma: đo từ `Tư vấn doanh nghiệp` ở cả ba khổ màn, 25/09/2026
//   Desktop 382:8829 · Tablet 480:2034 · Mobile 450:5540 — **đều cao 680**.
//
// ─── Xếp lớp, từ dưới lên ────────────────────────────────────────────
//   1. Milkyway   — ảnh nền sao, có thêm hiệu ứng nhiễu (NOISE)
//   2. Planet     — vòng cung hành tinh 1920×727, đặt ở y=344
//   3. Nebula light — vệt sáng cong, nằm trên đỉnh vòng cung
//   4. Chữ cong   — tên trang, chạy theo cung tròn
//   5. Khối nội dung — tiêu đề phụ + mô tả + nút
//
// 🗑️ Thắng đã XOÁ lớp `Top left light` khỏi Figma ngày 25/09 ("thấy không
//    cần thiết"). Đã gỡ khỏi code cho khớp.
//
// ─── Ba con số KHÔNG đổi ở cả ba khổ màn ─────────────────────────────
//   · Chiều cao Hero: 680
//   · Chữ cong: khung 1382×639, đặt ở y=240, **luôn căn giữa ngang**
//     (desktop x=−51 · tablet x=−307 · mobile x=−503 — tính ra tâm đều
//      trùng tâm màn hình)
//   · Vòng cung: 1920×727 ở y=344, cũng luôn căn giữa
//   → Nghĩa là hoạ tiết KHÔNG co theo màn. Màn hẹp thì thấy ít hơn,
//     chứ hình không bị bóp méo. Đây là điều dễ làm sai nhất ở section này.
//
// ─── Cỡ chữ cong — quy tắc rút ra từ ba số đo ────────────────────────
//   1280 → 80  ·  768 → 48  ·  375 → 24
//   Chia cho bề ngang màn: 6.25vw · 6.25vw · 6.4vw → **6.25vw khớp cả ba**.
//   Chặn trần 80 để màn rộng hơn 1280 không phóng to thêm (Figma dừng ở 1280).
//
// ─── ✅ ẢNH NỀN SAO — Thắng đã xuất, đã xử lý xong 25/09 ──────────────
// `Milkyway` trong Figma là **ảnh thật** (image fill) + hiệu ứng NOISE,
// không phải hình vẽ CSS. Proxy mạng chặn tên miền Figma ở cả hai môi
// trường (lỗi 403) nên Thắng phải xuất tay.
// Xem phần `.hero__stars` bên dưới về cách cắt và nén.
//
// ─── ⚠️ MỘT CHỖ BUỘC PHẢI LỆCH BẢN VẼ ────────────────────────────────
// Khối nội dung trong Figma rộng **527 cố định** ở cả ba khổ. Trên màn
// 375 thì 527 **tràn ra ngoài màn** (Figma đặt nó ở x=−76). Trên web
// không thể để vậy, nên ở đây là `max-width: 527px` + co theo màn.
// Đây là lỗi của bản vẽ, không phải lựa chọn của em.
import NebulaLight from './NebulaLight.astro';
import PlanetDome from './PlanetDome.astro';
import Button2 from './Button2.astro';

interface Props {
  /** Tên trang — chữ chạy theo cung tròn. Cũng là <h1> của trang. */
  title: string;
  /** Câu tiêu đề phụ, Chakra Petch Bold 32. */
  tagline: string;
  /** Đoạn mô tả ngắn bên dưới. */
  lead: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  title, tagline, lead,
  ctaLabel = 'Đặt lịch chẩn đoán',
  ctaHref = '#lien-he',
} = Astro.props;

// Mỗi trang một bộ id riêng cho đường dẫn chữ và gradient. Hai Hero cùng
// một trang thì không xảy ra, nhưng vẫn sinh id riêng cho chắc — trùng id
// là trình duyệt lấy nhầm của nhau.
const uid = Math.random().toString(36).slice(2, 8);
---

<section class="hero">
  {/* ─── Hoạ tiết. Toàn bộ `aria-hidden` — trình đọc màn hình bỏ qua. ─── */}
  <div class="hero__stars" aria-hidden="true"></div>

  <div class="hero__planet" aria-hidden="true">
    <PlanetDome huong="len" />
    <div class="hero__nebula"><NebulaLight width="100%" /></div>
  </div>

  {/* ─── Tên trang, chạy theo cung tròn ───────────────────────────────
      Dựng bằng SVG `<textPath>` — chữ THẬT, không phải ảnh. Quan trọng:
      đây là <h1> của trang, nên nó phải đọc được, chọn được, và Google
      phải đọc được. Xuất thành ảnh là mất hết.
      CSS thuần không uốn được chữ theo đường cong; SVG thì làm được. */}
  <h1 class="hero__title">
    <svg class="hero__arc" viewBox="0 0 1382 639" role="img" aria-label={title}>
      <defs>
        {/* Nửa trên của hình elip 1382×639 — đúng kích thước khung
            TEXT_PATH trong Figma. Vẽ từ trái sang phải để chữ đọc xuôi,
            điểm giữa cung nằm đúng đỉnh. */}
        <path id={`arc-${uid}`} fill="none"
              d="M 0 319.5 A 691 319.5 0 0 1 1382 319.5" />
        {/* ⚠️ SỬA 25/09 — Thắng đưa CSS gốc từ Figma:
              `linear-gradient(180deg, --tru-trung 0%, --tru-dam alpha-0 15.57%)`
            Tức gradient chạy **DỌC** (trên xuống) và **tắt rất sớm** — hết màu
            ở 15.57% chiều cao khung, tức y ≈ 99.5 trên khung cao 639.
            Bản trước em cho chạy NGANG vì đoán từ ảnh render (nhìn thấy chữ
            bên phải tối hơn nên tưởng là ngang). Thật ra chữ tối dần **xuống
            dưới** — chữ "nghiệp" trông tối hơn vì nó tụt thấp trên cung tròn,
            không phải vì nó nằm bên phải. Bài học: đừng đoán hướng gradient
            từ ảnh, đọc ma trận hoặc xin CSS gốc. */}
        <linearGradient id={`arcfill-${uid}`}
                        x1="0" y1="0" x2="0" y2="639"
                        gradientUnits="userSpaceOnUse">
          <stop offset="0"      stop-color="var(--tru-trung)" stop-opacity="1" />
          <stop offset="0.1557" stop-color="var(--tru-dam)"   stop-opacity="0" />
        </linearGradient>
      </defs>
      <text fill={`url(#arcfill-${uid})`} text-anchor="middle">
        <textPath href={`#arc-${uid}`} startOffset="50%">{title}</textPath>
      </text>
    </svg>
  </h1>

  {/* ─── Nội dung ─────────────────────────────────────────────────────
      `tagline` để <p> chứ không phải <h2>: nó là câu dẫn, không mở ra
      một mục mới nào. Tiêu đề thật của trang là chữ cong ở trên. */}
  <div class="hero__content">
    <div class="hero__text">
      <p class="hero__tagline">{tagline}</p>
      <p class="hero__lead">{lead}</p>
    </div>
    <Button2 label={ctaLabel} href={ctaHref} size="md"
             iconLeft={false} iconRight={false} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* 680 = 401 (chỗ trống phía trên) + 218 (nội dung) + 61 (dưới).
       `min-height` chứ không phải `height`: màn hẹp chữ xuống dòng nhiều
       hơn thì Hero cao thêm, không đè chữ ra ngoài. */
    min-height: 680px;
    padding: 401px var(--le-trang) 61px;
    box-sizing: border-box;
    /* ⚠️ KHÔNG cắt ở đây nữa — Thắng chốt 25/09: *"không được phép để
       section nào che hoặc cắt các vector/element trang trí"*.
       Việc chặn cuộn ngang chuyển lên tầng trang (`main`), cắt MỘT lần
       theo chiều ngang thay vì mỗi section tự cắt cả bốn phía.
       Xem ServicePageLayout.astro. */
    background: var(--gray-950);
  }

  /* --- 1 · Nền sao (Milkyway) -----------------------------------------
     🔴 SỬA 26/09 — Thắng chốt: *"Milkyway: Fill 100% (Scale)"*.
     Bản trước để khung CỐ ĐỊNH 1280 rồi căn giữa → ở màn 1905 lộ rõ hai dải
     tối hai bên, thấy được cả mép chữ nhật của tấm ảnh. Giờ khung rộng
     100% màn, ảnh `cover` (phóng đều, cắt phần thừa) nên không bao giờ méo.
       · màn 375–1280 : ảnh giữ cỡ thật 1280, cắt bớt hai bên — y như Figma
       · màn > 1280   : ảnh phóng lên theo bề ngang, bám mép trên

     🔴 VÀ ẢNH PHẢI ĐỦ CAO. Hôm 25/09 em cắt ảnh chỉ còn 470px vì tính rằng
     vòng cung che kín từ y=437 trở xuống. Con số 437 đó SAI — nó đến từ
     hình elip sai (xem mục 2). Vòng cung đúng thì ở mép màn nằm tận y≈531,
     nên cắt ở 470 sẽ lộ một dải không có sao. Đã lấy lại ảnh qua Figma MCP,
     giờ đủ 680 (= chiều cao Hero; Figma vẽ 694, 14px cuối luôn bị vòng cung
     che). 70 KB (1x) · 152 KB (2x).

     `mix-blend-overlay` (Dev Mode): sao HOÀ vào lớp dưới, không nằm đè lên. */
  .hero__stars {
    position: absolute;
    inset: 0 0 auto 0;
    height: 680px;
    background-image: image-set(
      url('/img/hero-stars.webp') 1x,
      url('/img/hero-stars@2x.webp') 2x
    );
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  /* --- 2 · Vòng cung hành tinh --------------------------------------
     Figma: khung `Planet` 1920 × 727 ở y=344, căn giữa.

     🔴 SỬA 26/09 — hai lỗi, Thắng chỉ ra:

     (a) HÌNH SAI. Bản trước vẽ một elip ĐẦY ĐỦ vừa khít khung 1920×727
         (`border-radius: 50%`). Nhưng `Planet` là **NỬA TRÊN** của một elip —
         vòm, đáy phẳng. Hai hệ quả:
           · nửa dưới elip thò xuống, thành cái nền lạ phía sau section
             "Bạn có đang gặp vấn đề này" (ảnh 2, ảnh 3 Thắng gửi)
           · vòng cung quá DẸT. Đã kiểm trên ảnh Figma: ở mép màn 1280 (lệch
             tâm 640px) vòng cung tụt 187px so với đỉnh. Elip đầy đủ cao 727
             chỉ tụt 92px; nửa elip bán trục 960 × 727 tụt đúng **185px** ✓
         → Vẽ elip đầy đủ 1920 × **1454** rồi CẮT BỎ nửa dưới bằng `clip-path`.
           Dùng clip-path chứ không dùng `overflow: hidden` vì phải chừa chỗ
           cho quầng sáng hắt NGƯỢC LÊN phía trên đỉnh vòm.

     (b) KHÔNG GIÃN THEO MÀN. Thắng chốt *"Planet Hero: Scale"*.
         Theo đúng nghĩa ràng buộc `Scale` của Figma: khung cha chỉ rộng ra
         (Hero luôn cao 680) thì hoạ tiết chỉ giãn NGANG, chiều cao giữ nguyên.
           · ≤ 1280 : cố định 1920 — đúng số đo cả ba khổ Figma
           · > 1280 : 150% bề ngang màn (= 1920/1280) — tại 1280 hai cách ra
                      cùng một số nên không có bước nhảy */
  .hero__planet {
    position: absolute;
    top: 344px;
    left: 50%;
    width: max(1920px, 150vw);
    height: 727px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  /* Mái vòm: component dùng chung `PlanetDome` (huong="len") — lấy thông số
     của bát "Bạn sẽ nhận được gì", lật dọc. Thắng chốt 26/09. */

  /* --- 3 · Vệt sáng cong trên đỉnh cung -------------------------------
     Figma: `Neubula light` 694.5 × 54.111 ở (613.5, 0) trong khung Planet.
     Đường cong của nó bám ĐÚNG vòng cung: ở hai đầu (lệch tâm 347px) vòng
     cung tụt 49px — khớp chiều cao 54 của vệt sáng. Chỉ đúng khi vòng cung
     đã sửa thành nửa elip (mục 2); với elip cũ hai đường lệch nhau.

     Đặt theo PHẦN TRĂM khung Planet (613.5/1920 · 694.5/1920) để khi Planet
     giãn ngang ở màn rộng, vệt sáng giãn theo và vẫn bám vòng cung.
     🔴 Bản trước để `top: -8px` bù cho vòng cung sai — đã bỏ, giờ đúng 0. */
  .hero__nebula {
    position: absolute;
    top: 0;
    left: 31.953%;
    width: 36.172%;
  }

  /* --- 4 · Chữ cong ---------------------------------------------------
     Khung 1382×639 ở y=240, căn giữa — cố định, KHÔNG co theo màn. */
  .hero__title {
    position: absolute;
    top: 240px;
    left: 50%;
    width: 1382px;
    height: 639px;
    margin: 0;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .hero__arc {
    display: block;
    width: 1382px;
    height: 639px;
    overflow: visible;
  }
  .hero__arc text {
    font-family: var(--font-body);      /* Be Vietnam Pro */
    font-weight: 600;                   /* SemiBold */
    /* 6.25vw ra đúng 80 ở 1280 và 48 ở 768; ở 375 ra 23.4 (bản vẽ 24).
       Chặn trần 80 vì Figma dừng vẽ ở khổ 1280. */
    font-size: min(6.25vw, 80px);
  }

  /* --- 5 · Nội dung ---------------------------------------------------
     Figma: khung 527, xếp dọc, gap 40, các con căn giữa ngang. */
  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-10);                   /* 40 */
    /* 527 là bề ngang trong bản vẽ; `max-width` để màn 375 không tràn.
       Xem cảnh báo ở đầu file. */
    max-width: 527px;
    margin-inline: auto;
    text-align: center;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);                    /* 12 */
  }

  .hero__tagline {
    margin: 0;
    font-family: var(--font-heading);   /* Chakra Petch */
    font-size: var(--fs-h1);            /* 32 */
    line-height: var(--lh-h1);          /* 37 */
    font-weight: var(--fw-h1);          /* Bold */
    color: var(--slate-50);
  }

  .hero__lead {
    margin: 0;
    /* Figma để đoạn này rộng 431 trong khung 527 — hẹp hơn tiêu đề một
       chút để dòng chữ không quá dài. Giữ đúng tỉ lệ đó. */
    max-width: 431px;
    font-size: var(--fs-body);          /* 15 */
    line-height: var(--lh-body);        /* 130% */
    color: var(--slate-50);
  }
</style>
