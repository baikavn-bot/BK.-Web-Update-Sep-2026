---
import Button from './Button.astro';

// Khối hero trang chủ — chiếm 2×2 ô ở góc trái lưới bento.
// Figma: `Container` 512×416 trong Grid Container 534:3826.
interface Props { area: string; }
const { area } = Astro.props;
---

<div class="hero" style={`--area: ${area}`}>
  {/*
    Khối nhận diện: biểu tượng BAIKA + chữ "Baika".

    🔴 28/09 — HỆ LOGO MỚI. Figma `Logo` 691:4420 (392×120): `Logo / Symbol`
    107×120 (biểu tượng mới, dải màu --blue-100 → trong suốt) + chữ "Baika"
    Chakra Petch 120 cùng dải màu. Thay cho ảnh WebP cũ (dấu hiệu vuông xanh).

    Dùng file SVG xuất THẲNG từ Figma (chữ đã chuyển thành nét vẽ), đã so
    checksum trùng từng ký tự: nét luôn sắc ở mọi cỡ màn, không phụ thuộc
    font tải về, và nhẹ hơn ảnh cũ (12 KB so với 16 + 38 KB).
    Tablet/Mobile trong Figma là cùng khối này thu nhỏ (100 và 80 cao) —
    ở đây thu nhỏ theo tỉ lệ khung, xem `.hero__lockup`.
  */}
  <img
    class="hero__lockup"
    src="/img/logo/baika-lockup-home.svg"
    alt="BAIKA"
    width="392"
    height="120"
    fetchpriority="high"
  />

  {/* Tiêu đề chính <h1> của trang chủ (Thắng chốt 04/10): dùng chính dòng mô tả có
      sẵn trong Figma — chữ thật nhìn thấy được, không thêm chữ mới. Trước 04/10 là <p>
      nên trang chủ không có h1 nào (Google + trình đọc màn hình cần đúng một h1). */}
  <h1 class="hero__tagline">
    BAIKA rà soát và dựng lại hệ thống vận hành — từ mô hình kinh doanh đến tài chính, pháp lý, công nghệ.
  </h1>

  {/* Figma: Home có đúng 3 instance Button 1 — Lg ở Desktop (534:3846, 128×44),
      Md ở Tablet (117×36), Sm ở Mobile (108×34). Trục Type = breakpoint,
      nên ở đây dùng `auto` thay vì ép một cỡ. Đã xác minh bằng kiểm kê instance. */}
  <Button label="liên hệ" href="/lien-he" size="auto" />
</div>

<style>
  .hero {
    grid-area: var(--area);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Figma Desktop: logo kết ở y=275, chữ bắt đầu y=288 → cách 12–13px */
    gap: var(--s-3);
    padding: var(--s-6);
    /* Mobile: khối nội dung nằm khoảng giữa ô (Figma: y 96→292 trong 416) */
    justify-content: center;
  }

  /* Tablet: nội dung dồn LÊN TRÊN.
     Hai lý do, cùng chỉ về một hướng:
     1. Figma đặt vậy — chữ "Baika" ở y=52, nút kết ở y=253.
     2. Ở tablet, ô CÔNG NGHỆ AI nằm đè lên góc dưới–phải của khối hero
        (x 256–512, y 208–416). Dồn nội dung xuống đáy là dòng mô tả sẽ
        chui xuống dưới ô đó. */
  @media (min-width: 768px) {
    .hero { justify-content: flex-start; }
  }

  /* Desktop: dồn XUỐNG ĐÁY — Figma: nút kết ở y=388 trong ô cao 416. */
  @media (min-width: 1280px) {
    .hero { justify-content: flex-end; }
  }

  /* Cân bằng động: lưới giãn theo màn hình, nên khối logo phải giãn theo,
     không đứng yên ở 392px.
     Tỉ lệ lấy từ Figma: hero 512 rộng, trừ 2×24 lề còn 464 — logo 392
     chiếm 84.5% chỗ đó. Giữ đúng tỉ lệ ấy ở mọi cỡ màn.
     Chặn trên 784px (gấp đôi bản vẽ) để màn siêu rộng không phóng logo to
     quá khổ. (Trước đây 784 là giới hạn độ nét của ảnh WebP; giờ là SVG,
     không còn nhoè, nhưng giữ mốc cũ cho bố cục không đổi.) */
  /* 🔴 28/09 — Tablet/Mobile theo ĐÚNG cỡ Figma của hệ logo mới:
       Mobile 540:4115 → biểu tượng cao 80 · Tablet 540:4027 → cao 100.
     Trước đây hai khổ này dùng chung quy tắc % của desktop nên logo tablet
     ra 120 cao (to hơn bản vẽ 20%), mobile ra 72 (nhỏ hơn 10%). */
  .hero__lockup {
    width: auto;
    height: 80px;
    max-width: 100%;
    /* Màn hẹp hơn 320: khung co bề ngang thì logo thu nhỏ GIỮ tỉ lệ, dạt
       trái — không bị bóp méo. */
    object-fit: contain;
    object-position: left center;
  }
  @media (min-width: 768px) {
    .hero__lockup { height: 100px; }
  }
  @media (min-width: 1280px) {
    .hero__lockup {
      width: min(84.5%, 784px);
      height: auto;
    }
  }

  .hero__tagline {
    margin: 0;
    /* h1 mặc định lấy chữ tiêu đề (global.css) — giữ đúng chữ thường như khi còn là <p>. */
    font-family: inherit;
    font-weight: inherit;
    max-width: 464px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--gray-50);
  }
</style>
