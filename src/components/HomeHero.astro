---
import Button from './Button.astro';

// Khối hero trang chủ — chiếm 2×2 ô ở góc trái lưới bento.
// Figma: `Container` 512×416 trong Grid Container 534:3826.
interface Props { area: string; }
const { area } = Astro.props;
---

<div class="hero" style={`grid-area: ${area}`}>
  <div class="hero__logo">
    <!-- Khối nền xanh bo góc + gradient toả: dựng bằng CSS.
         Dấu hiệu BAIKA bên trong là file ảnh — xem public/img/README.txt -->
    <img class="hero__mark" src="/img/baika-logo.webp" alt="" width="91" height="100" />
  </div>

  <!-- Chữ "Baika" là LOGOTYPE, không thuộc thang chữ 9 bậc.
       Chakra Petch Regular 120px, line-height 75%, gradient mờ dần.
       Thắng chốt 24/09: không thêm bậc chữ mới vào tokens.css. -->
  <p class="hero__wordmark" aria-hidden="true">Baika</p>

  <p class="hero__tagline">
    BAIKA rà soát và dựng lại hệ thống vận hành — từ mô hình kinh doanh đến tài chính, pháp lý, công nghệ.
  </p>

  <Button label="liên hệ" href="/lien-he" size="md" />
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--s-4);
    padding: var(--s-6);
  }

  .hero__logo {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: var(--r-xl);
    border: 0.5px solid var(--gray-600);
    background: var(--blue-50);
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* Quầng sáng toả từ tâm — thay cho lớp BG gradient radial + blur trong Figma */
  .hero__logo::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 45%, var(--blue-200), transparent 70%);
    filter: blur(13px);
  }

  .hero__mark {
    position: relative;
    width: 91px;
    height: 100px;
    object-fit: contain;
  }

  .hero__wordmark {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 120px;
    line-height: 0.75;
    font-weight: 400;
    background: linear-gradient(180deg, var(--blue-100) 0%, rgb(11 23 48 / 0%) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__tagline {
    margin: 0;
    max-width: 464px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--gray-50);
  }

  @media (max-width: 767px) {
    .hero__wordmark { font-size: 88px; }
    .hero__logo { width: 96px; height: 96px; }
    .hero__mark { width: 73px; height: 80px; }
  }
</style>
