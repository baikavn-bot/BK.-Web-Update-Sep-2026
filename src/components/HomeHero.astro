---
import Button from './Button.astro';

// Khối hero trang chủ — chiếm 2×2 ô ở góc trái lưới bento.
// Figma: `Container` 512×416 trong Grid Container 534:3826.
interface Props { area: string; }
const { area } = Astro.props;
---

<div class="hero" style={`grid-area: ${area}`}>
  {/*
    Khối nhận diện: dấu hiệu BAIKA + chữ "Baika" nằm chung MỘT ảnh.
    Thắng cung cấp bản PNG @2x ngày 24/09; đã chuyển sang WebP.

    Vì sao dùng ảnh thay vì dựng bằng CSS:
    - Chữ "Baika" là LOGOTYPE (Chakra Petch 120px + gradient mờ dần), không
      thuộc thang chữ 9 bậc. Dựng bằng CSS thì phụ thuộc font tải về đúng
      weight, và gradient chỉ là xấp xỉ.
    - Dấu hiệu bên trái có gradient và chi tiết, vẽ lại bằng SVG dễ sai lệch.
    Ảnh cho kết quả đúng y bản gốc và không phụ thuộc gì cả.

    Cỡ hiển thị 392×120 = đúng số đo khối này trong Figma.
  */}
  <img
    class="hero__lockup"
    src="/img/baika-lockup.webp"
    srcset="/img/baika-lockup.webp 1x, /img/baika-lockup@2x.webp 2x"
    alt="BAIKA"
    width="392"
    height="120"
    fetchpriority="high"
  />

  <p class="hero__tagline">
    BAIKA rà soát và dựng lại hệ thống vận hành — từ mô hình kinh doanh đến tài chính, pháp lý, công nghệ.
  </p>

  <Button label="liên hệ" href="/lien-he" size="md" />
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: var(--s-4);
    padding: var(--s-6);
  }

  .hero__lockup {
    width: 392px;
    max-width: 100%;
    height: auto;
  }

  .hero__tagline {
    margin: 0;
    max-width: 464px;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--gray-50);
  }
</style>
