---
// VỆT SÁNG CONG — Figma `Neubula light` 573:3960. Đo 25/09/2026.
// (Tên trong Figma viết thiếu chữ: "Neubula" — đúng ra là "Nebula", tinh vân.
//  Giữ nguyên tên file theo cách gọi trong dự án để khỏi lạc khi tra cứu.)
//
// Mỗi trang dịch vụ dùng 2 cái. Thuần trang trí — có `aria-hidden` nên
// trình đọc màn hình bỏ qua hoàn toàn.
//
// Cấu tạo: **MỘT đường cong duy nhất, vẽ ba lần chồng lên nhau**, mỗi lần
// một mức mờ khác (blur 6 / 24 / 40 trong Figma = 3 / 12 / 20 trong CSS).
// Lớp mờ nhiều nằm dưới tạo quầng, lớp nét gọn nằm trên tạo lõi sáng —
// đúng cách người ta vẽ đèn neon.
//
// ✅ Chỗ này dựng bằng SVG được, KHÁC hoạ tiết nền trang chủ.
//    Lý do: đây là một ĐƯỜNG NÉT (stroke 7px) có đúng 4 điểm điều khiển,
//    chép thẳng được. Hoạ tiết nền trang chủ là những MẢNG hình tự do
//    chồng nhau, nên lần đó phải xuất ảnh.
//    SVG ở đây chỉ nặng vài trăm byte và sắc nét ở mọi cỡ màn.
//
// ⚠️ Màu gốc trong Figma là #FFFFFF (trong suốt → đặc → trong suốt).
//    CLAUDE.md mục 4 cấm #FFFFFF nên đổi sang `--gray-50`, sáng nhất của hệ.
interface Props {
  /** Bề ngang. Mặc định **694.5** — đúng bản vẽ (không phải 695). */
  width?: string;
}
const { width = '694.5px' } = Astro.props;

// Ba lớp cần ba `id` riêng. Nếu hai vệt sáng cùng nằm trên một trang mà
// dùng chung id thì trình duyệt lấy nhầm bộ lọc của cái kia → sai độ mờ.
// Sinh một mã ngẫu nhiên lúc build để mỗi lần đặt là một bộ id riêng.
const uid = Math.random().toString(36).slice(2, 8);

// Đường cong lấy nguyên văn từ `vectorPaths` trong Figma.
const duongCong =
  'M 0 54.111 C 105.833 13.278 392.9 -43.889 694.5 54.111';

// [độ mờ trong Figma, độ mờ trong CSS] — luật chia đôi, xem DEC-083.
const lop = [40, 24, 6].map((figma) => ({ figma, css: figma / 2 }));
---

<svg
  class="neb"
  style={`width: ${width}`}
  viewBox="0 0 694.5 54.111"
  preserveAspectRatio="none"
  overflow="visible"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={`neb-${uid}`} x1="0" y1="0" x2="694.5" y2="0"
                    gradientUnits="userSpaceOnUse">
      <stop offset="0"     stop-color="var(--gray-50)" stop-opacity="0" />
      <stop offset="0.505" stop-color="var(--gray-50)" stop-opacity="1" />
      <stop offset="1"     stop-color="var(--gray-50)" stop-opacity="0" />
    </linearGradient>

    {lop.map((l) => (
      <filter
        id={`neb-${uid}-b${l.figma}`}
        /* Vùng vẽ phải nới rộng ra, nếu không quầng sáng bị cắt cụt ở mép. */
        x="-20%" y="-300%" width="140%" height="700%"
      >
        <feGaussianBlur stdDeviation={l.css} />
      </filter>
    ))}
  </defs>

  {lop.map((l) => (
    <path
      d={duongCong}
      stroke={`url(#neb-${uid})`}
      stroke-width="7"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
      filter={`url(#neb-${uid}-b${l.figma})`}
    />
  ))}
</svg>

<style>
  /* 🔴 SỬA 26/09 — vệt sáng bị CẮT PHẲNG ở trên (ảnh 1 Thắng gửi).
     Nguyên nhân: thẻ <svg> mặc định cắt mọi thứ vẽ ra ngoài khung
     `viewBox` của nó. Đường cong chạm sát mép trên khung (y≈0), nên quầng
     mờ 20px hắt lên trên bị xén gọn thành một đường thẳng.
     Figma xuất vệt sáng này rộng hơn khung 80% mỗi phía trên/dưới
     (`inset: -80.39% -6.26%`) — tức quầng sáng CỐ Ý tràn ra ngoài.
     → `overflow: visible` cho phép vẽ ra ngoài khung.

     Chiều cao KHOÁ 54.111 + `preserveAspectRatio="none"`: khi khung cha
     giãn ngang (màn rộng hơn 1280), vệt sáng chỉ giãn ngang theo vòng cung,
     không phình cao lên. `non-scaling-stroke` giữ nét luôn đúng 7px. */
  .neb {
    display: block;
    height: 54.111px;
    overflow: visible;
    pointer-events: none;
  }
</style>
