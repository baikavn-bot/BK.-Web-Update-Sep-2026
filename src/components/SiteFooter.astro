---
// CHÂN TRANG DÙNG CHUNG — Figma `Footer` 450:5263.
// Dựng lại ngày 26/09/2026 bằng **Dev Mode** (lần trước đọc bằng Plugin API,
// sai nhiều chỗ — xem cuối file).
//
//   Desktop 217:2648 (1280) · Tablet 489:2986 (768) · Mobile 450:5264 (375)
//
// Ba khổ CÙNG cao 680, cùng gap 24, cùng xếp dọc + dồn xuống đáy.
// Khác nhau đúng bốn chỗ:
//
//   |                | Desktop      | Tablet       | Mobile          |
//   |----------------|--------------|--------------|-----------------|
//   | padding        | 40           | 40           | 40 dọc / 24 ngang |
//   | khối Details   | NGANG, cao 80| NGANG, cao 80| DỌC, cao 165 — Liên hệ lên trước |
//   | dòng cuối      | NGANG        | NGANG        | DỌC, gap 12 — "Design by" lên trước |
//   | chữ BAIKA      | 358px, top 0 | 220px, top 46| 100px, top 129  |
//
// Chữ BAIKA ở cả ba khổ đều CĂN GIỮA khung: Figma ghi `left: calc(50% - 600px)`
// với cỡ 358 (chữ rộng đúng 1201 = 600,5 × 2), `calc(50% - 369px)` với cỡ 220
// (rộng 738), `calc(50% - 168,5px)` với cỡ 100 (rộng 337). Ba lần đều khít.
// → Ở đây dùng `left: 50%` + `translateX(-50%)`: cùng kết quả, mà không phụ
//   thuộc vào việc chữ có rộng đúng từng pixel như trong Figma hay không.
//
// ──────────────────────────────────────────────────────────────────────
//
// ⚠️ HOẠ TIẾT `Planet` — ĐANG LÀ BẢN DỰNG LẠI BẰNG CSS, CẦN THẮNG DUYỆT.
//
// Trong Figma đây là **một file SVG xuất sẵn** (`52e72.svg`), dùng chung cho
// cả ba khổ. Em KHÔNG tải được file đó: cả máy chủ trong đám mây lẫn máy anh
// đều bị chính sách mạng của tổ chức chặn `www.figma.com` (lỗi 403). Em không
// được phép đi vòng, nên chỉ còn hai đường:
//
//   (a) Dựng lại bằng CSS — đang làm ở đây. Ưu điểm: co giãn đúng ở mọi bề
//       ngang màn (chân trang chạy suốt từ 375 tới hơn 1920), không thêm file
//       phải tải, đúng luật "ưu tiên CSS/SVG" trong CLAUDE.md.
//       Nhược: là bản DỰNG LẠI theo ảnh render, không phải bản sao từng pixel.
//
//   (b) Anh xuất tay `52e72.svg` từ node `Planet` 219:2878 rồi bỏ vào
//       `public/img/`. Em đổi khối CSS này lấy một thẻ <img> — sửa một chỗ.
//
// Em đã đối chiếu bản dựng với ảnh render thật của Figma (chụp qua MCP), không
// vẽ mò. Nhưng "giống" và "đúng" là hai chuyện — anh nhìn rồi quyết.
//
// ──────────────────────────────────────────────────────────────────────
//
// Cụm TIA SÁNG hắt lên từ sau hành tinh — tạo nên vùng sáng phía trên
// đường chân trời, với mép trên dạng **răng lược**.
//
// [SUY LUẬN, không phải đã xác minh] Em chụp node `Planet` qua Figma MCP rồi
// dò từng cột pixel để tìm mép trên vùng sáng, và dựng lại bằng 9 hình chữ
// nhật phủ blur 80 (Figma) = blur 40 (CSS). Các tia giãn dần ra hai bên
// (240 → 240 → 280 → 280) và thấp dần.
//
// ⚠️ Vì sao chỉ là suy luận: HAI ảnh render của Figma cho cùng node này KHÔNG
//    khớp nhau. Ảnh chụp riêng `Planet` thì nửa trên TỐI (độ sáng 40–90/255);
//    ảnh chụp cả chân trang thì nửa trên SÁNG (100–160/255). Em lấy ảnh chụp
//    CẢ CHÂN TRANG làm chuẩn — đó mới là thứ người dùng nhìn thấy.
//    Độ sáng đã dò khớp tới sai số trung bình ~7%; còn *hình dạng* các tia
//    thì chưa chắc, vì trong ảnh chụp cả chân trang chữ BAIKA che mất vùng
//    cần đo. Xuất được file SVG là hết chuyện này.
//
// `x`   = tâm tia, toạ độ trong khung hoạ tiết rộng 1920
// `w`   = bề rộng tia
// `top` = mép trên (số âm = cao hơn khung, bị cắt)
const TIA = [
  { x:  -80, w: 320, top: 390 },
  { x:  200, w: 300, top: 310 },
  { x:  480, w: 280, top: 250 },
  { x:  720, w: 260, top: 240 },
  { x:  960, w: 250, top: -200 },   // tia giữa — cao vọt, bị khung cắt mất ngọn
  { x: 1200, w: 260, top: 240 },
  { x: 1440, w: 280, top: 250 },
  { x: 1720, w: 300, top: 310 },
  { x: 2000, w: 320, top: 390 },
];

interface Props {
  /** Số điện thoại hiển thị. */
  phone?: string;
  email?: string;
  address?: string;
}
const {
  phone = '0905 247 365',
  email = 'baika.vn@gmail.com',
  address = 'Tầng 15, 72 Lê Thánh Tôn,\nP. Sài Gòn, Thành phố Hồ Chí Minh',
} = Astro.props;
---

<footer class="ft">
  {/* --- Hoạ tiết hành tinh --- */}
  <div class="ft__planet" aria-hidden="true">
    <div class="ft__tia-cum">
      {/* Toạ độ đi qua biến CSS `--x` / `--w` / `--top`, KHÔNG viết thẳng
          left/top/width. Lý do: ở khổ nhỏ các khối này có thể đổi cách xếp,
          lúc đó `left` viết thẳng sẽ ĐẨY LỆCH chứ không định vị —
          bài học DEC-060. */}
      {TIA.map((t) => (
        <span class="ft__tia" style={`--x:${t.x}px; --w:${t.w}px; --top:${t.top}px`}></span>
      ))}
    </div>

    {/* Thứ tự lớp: tia sáng → quầng sáng → thân hành tinh → điểm loé.
        Thân hành tinh phải nằm TRÊN quầng sáng, nếu không quầng sẽ hắt cả
        xuống nửa dưới đường chân trời — mà đo trên bản vẽ thì nửa dưới là
        một dải chuyển màu dọc thuần, không có quầng. */}
    <div class="ft__glow"></div>
    <div class="ft__globe"></div>
    <div class="ft__flare"></div>
  </div>

  {/* --- Chữ lớn. `aria-hidden` vì đây là hoạ tiết chữ, không phải nội
        dung: tên công ty đã có ở logo trên đầu trang, đọc lại là thừa. --- */}
  <p class="ft__wordmark" aria-hidden="true">Baika</p>

  <div class="ft__details">
    <div class="ft__block ft__block--address">
      <p class="ft__label">Địa chỉ</p>
      <p class="ft__value">{address}</p>
    </div>

    <div class="ft__block ft__block--contact">
      <p class="ft__label">Liên hệ</p>
      <p class="ft__value">
        <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>
      </p>
      <p class="ft__value">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
  </div>

  <hr class="ft__line" />

  <div class="ft__legal">
    <p class="ft__rights">All rights reserved for Baika</p>
    <p class="ft__by">Design by Baika</p>
  </div>
</footer>

<style>
  /* =====================================================================
     KHUNG
     Dev Mode: flex · column · items-center · justify-end · gap 24 · h 680
     ===================================================================== */
  .ft {
    position: relative;
    z-index: 0;
    /* `isolation` khoá hiệu ứng hoà trộn của chữ BAIKA lại trong chân trang.
       Thiếu dòng này, `mix-blend-mode: overlay` sẽ đi tìm cả nền trang phía
       trên mà trộn — chữ đổi màu theo từng trang, không kiểm soát được. */
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;     /* Figma: dồn nội dung xuống đáy */
    gap: var(--s-6);               /* 24 */
    /* Figma khoá cứng 680. Ở đây để `min-height` phòng khi chữ xuống dòng
       nhiều hơn dự tính — thà chân trang cao thêm còn hơn cắt mất chữ. */
    min-height: 680px;
    padding: var(--s-10);          /* 40 — mobile đổi lề ngang xuống 24 */
    overflow: hidden;              /* Figma `overflow-clip` */
    background: var(--gray-950);   /* chân trang nằm NGOÀI <main> nên phải tự
                                      đặt nền, không thừa hưởng nền trang */
  }

  /* =====================================================================
     HOẠ TIẾT HÀNH TINH
     Khung 1920 × 1000, căn giữa, bám đỉnh — Figma giữ NGUYÊN số này ở cả ba
     khổ. Nghĩa là ở mobile nó tràn ra hai bên rất nhiều, và đó là chủ ý:
     vòng cung phải thoai thoải. Co nó lại theo bề ngang màn là hỏng.
     ===================================================================== */
  .ft__planet {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 0;
    width: 1920px;
    height: 1000px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  /* --- Cụm tia sáng ----------------------------------------------------
     Blur 40 (= Figma blur 80) đặt trên CẢ CỤM, không đặt riêng từng tia —
     đúng như Figma làm: một group, một hiệu ứng. Đặt riêng từng tia thì chỗ
     hai tia gặp nhau sẽ hiện ra thành vệt, không liền thành răng lược. */
  .ft__tia-cum {
    position: absolute;
    inset: 0;
    filter: blur(var(--blur-80));   /* Figma LayerBlur/Unifrom/80 → CSS 40 */
  }
  .ft__tia {
    position: absolute;
    left: var(--x);
    top: var(--top);
    width: var(--w);
    /* Kéo xuống 470 — chỗ đó đã nằm dưới đường chân trời nên bị thân hành
       tinh che. Mờ dần về phía dưới để không tạo vệt cứng chỗ giáp ranh. */
    height: calc(470px - var(--top));
    transform: translateX(-50%);
    /* Mờ dần LÊN phía ngọn: đo trên bản vẽ, ở y=340 tia cho thêm ~50/255,
       lên tới y=240 chỉ còn ~5. Tia sáng nhạt dần khi xa nguồn. */
    background: linear-gradient(
      180deg,
      transparent 0%,
      color-mix(in srgb, var(--gray-50) 26%, transparent) 35%,
      color-mix(in srgb, var(--gray-50) 45%, transparent) 78%,
      color-mix(in srgb, var(--gray-50) 30%, transparent) 100%
    );
  }

  /* --- Quầng sáng ÔM LẤY vòng cung -------------------------------------
     Thứ làm nên cảm giác "mặt trời đang mọc sau hành tinh", và cũng chính là
     chỗ bản dựng lần trước thiếu hẳn: lần đó nửa trên chân trang tối thui,
     trong khi bản vẽ nửa trên SÁNG hơn nửa dưới.

     ⚠️ Không phải một quầng tròn đặt ở đỉnh. Em đã thử cách đó rồi đo lại:
        ở hai mép màn, chỗ ngay trên đường chân trời, bản vẽ sáng 98–112/255
        còn bản dựng chỉ 57. Lý do: vùng sáng CHẠY THEO đường cong, tụt xuống
        cùng nó, chứ không nằm ngang.
     → Ở đây dùng đúng elip của hành tinh nhưng PHÌNH RA 200px mỗi phía, rồi
       tô sáng ở vành ngoài. Thân hành tinh vẽ đè lên sau, nên phần quầng nằm
       dưới đường chân trời bị che — chỉ còn thấy phần hắt lên trên. */
  .ft__glow {
    position: absolute;
    left: -26.615%;                /* −511 / 1920 */
    top: 18.4%;                    /*  184 / 1000 */
    width: 153.281%;               /* 2943 / 1920 */
    height: 253%;                  /* 2530 / 1000 */
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      transparent 0%,
      transparent 62%,
      color-mix(in srgb, var(--gray-50)  7%, transparent) 76%,
      color-mix(in srgb, var(--gray-50) 17%, transparent) 86%,
      color-mix(in srgb, var(--gray-50) 26%, transparent) 94%,
      transparent 100%
    );
  }

  /* --- Thân hành tinh ---------------------------------------------------
     Elip 2543 × 2130, đỉnh ở (−311, 384) trong khung 1920 × 1000.
     ⚠️ Số này ĐO LẠI ngày 26/09 bằng cách dò pixel trên ảnh render thật rồi
        khớp phương trình elip (sai số trung bình 0,6px). Bản trước ghi cao
        740 — sai; đường cong dựng ra dốc hơn bản vẽ khá nhiều.
        Bề rộng 2543 thì trùng khớp với số đọc được từ Figma, nên yên tâm.
     Elip rộng hơn khung (2543 > 1920) nên ở màn siêu rộng đường chân trời
     vẫn chạy tới sát hai mép. */
  .ft__globe {
    position: absolute;
    left: -16.198%;                /* −311 / 1920 */
    top: 38.4%;                    /*  384 / 1000 */
    width: 132.448%;               /* 2543 / 1920 */
    height: 213%;                  /* 2130 / 1000 */
    border-radius: 50%;
    /* Mặt hành tinh sáng dần LÊN phía đường chân trời. Đây là gradient DỌC
       thuần: em đã đo, ở cùng một độ cao y thì độ sáng bằng nhau từ mép trái
       sang mép phải — không có điểm sáng cục bộ nào.
       Các mốc % dưới đây là độ sâu tính theo chiều cao elip (2130), lấy từ
       số đo: y=440 → 141/255, y=480 → 102, y=520 → 73, y=560 → 50,
       y=600 → 31, y=640 → 14, tắt hẳn quanh y=690. */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--gray-50) 70%,   transparent) 0%,
      color-mix(in srgb, var(--gray-50) 38%,   transparent) 2.63%,
      color-mix(in srgb, var(--gray-50) 22%,   transparent) 4.51%,
      color-mix(in srgb, var(--gray-50) 14%,   transparent) 6.38%,
      color-mix(in srgb, var(--gray-50) 7%,    transparent) 8.26%,
      transparent 10.2%
    );
  }

  /* Viền sáng chạy dọc mép trên elip.
     Kỹ thuật: phủ một lớp gradient lên toàn elip rồi KHOÉT RỖNG phần ruột,
     chỉ chừa lại vành ngoài cùng (`mask-composite: exclude`). Cách này giữ
     NGUYÊN kích thước elip — khác với `border`, vốn cộng thêm bề dày.
     Xem thêm FaqItem.astro, cùng một kỹ thuật.
     Các mốc % là vị trí theo bề ngang elip, độ sáng đo từ ảnh render:
     25% → 115/255 · 31% → 170 · 37% → 216 · 44% → 245 · 50% → 250. */
  .ft__globe::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(
      90deg,
      transparent 8%,
      color-mix(in srgb, var(--gray-50) 46%, transparent) 25%,
      color-mix(in srgb, var(--gray-50) 69%, transparent) 31%,
      color-mix(in srgb, var(--gray-50) 87%, transparent) 37%,
      var(--gray-50) 46%,
      var(--gray-50) 54%,
      color-mix(in srgb, var(--gray-50) 87%, transparent) 63%,
      color-mix(in srgb, var(--gray-50) 69%, transparent) 69%,
      color-mix(in srgb, var(--gray-50) 46%, transparent) 75%,
      transparent 92%
    );
    -webkit-mask:
      linear-gradient(var(--gray-950) 0 0) content-box,
      linear-gradient(var(--gray-950) 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }
  /* Trình duyệt cũ không khoét rỗng được thì bỏ hẳn viền, còn hơn hiện ra
     một elip đặc màu sáng đè lên tất cả. */
  @supports not ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
    .ft__globe::before { display: none; }
  }

  /* --- Điểm loé ở đỉnh vòng cung ----------------------------------------
     Nhỏ thôi: đo được độ sáng tụt từ 249 xuống 135 chỉ trong 24px phía trên
     đỉnh, nên đây là một chấm sáng gọn chứ không phải quầng lớn. */
  .ft__flare {
    position: absolute;
    left: 50%;
    top: 384px;
    width: 190px;
    height: 76px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      ellipse 50% 50% at 50% 50%,
      var(--gray-50) 0%,
      color-mix(in srgb, var(--gray-50) 55%, transparent) 34%,
      transparent 76%
    );
    filter: blur(var(--blur-24));  /* Figma LayerBlur/Unifrom/24 → CSS 12 */
  }

  /* =====================================================================
     CHỮ BAIKA
     ===================================================================== */
  .ft__wordmark {
    position: absolute;
    top: 129px;                    /* Mobile. Tablet 46 · Desktop 0 */
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;                    /* NẰM TRÊN hoạ tiết, DƯỚI phần chữ đọc
                                      được — đúng thứ tự lớp trong Figma */
    margin: 0;
    font-family: var(--font-display);
    font-weight: 900;              /* Be Vietnam Pro Black. Đã phải thêm
                                      `;900` vào link Google Fonts ở
                                      BaseLayout — trước đó chỉ nạp tới 700,
                                      trình duyệt sẽ bôi đậm giả. */
    font-size: 26.6vw;             /* Mobile: 375 → 100 */
    line-height: 0.85;             /* Figma: 85% */
    text-transform: uppercase;
    /* Bắt buộc MỘT dòng. Thiếu dòng này chữ xuống hàng thành "BAIK / A" —
       đã thấy thật khi chụp thử. */
    white-space: nowrap;
    /* Gradient NGANG, tô vào chính nét chữ. Dev Mode: `bg-gradient-to-r`,
       điểm giữa ở **50,962%**. `background-clip: text` biến nét chữ thành
       "cửa sổ" nhìn xuyên xuống lớp gradient bên dưới. */
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--gray-50) 50%, transparent) 50.962%,
      transparent 100%
    );
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    /* Dev Mode: `mix-blend-overlay`. Đây là lý do trong bản vẽ chữ *tan vào*
       vòng cung chứ không nằm đè lên như một lớp chữ dán thêm. */
    mix-blend-mode: overlay;
    user-select: none;
  }

  /* =====================================================================
     KHỐI THÔNG TIN
     ===================================================================== */
  .ft__details,
  .ft__line,
  .ft__legal {
    position: relative;
    z-index: 2;                    /* trên cả hoạ tiết lẫn chữ BAIKA */
    width: 100%;
  }

  .ft__details {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-6);
    overflow: hidden;              /* Figma `overflow-clip` */
    word-break: break-word;
  }
  .ft__block {
    display: flex;
    flex-direction: column;
    /* Dev Mode ghi thẳng `gap-[7px]` ở cả ba khổ — đúng 7, không phải token.
       Đây là giá trị ngoài thang `--s-*`, cùng loại với 14 mà anh đã sửa về
       12. Muốn sạch thang thì sửa Figma về 8, em đổi lại một dòng. */
    gap: 7px;
    width: 300px;
    max-width: 100%;
  }
  .ft__block--contact {
    align-items: flex-end;
    text-align: right;
    white-space: nowrap;           /* Dev Mode: `whitespace-nowrap` */
  }
  .ft__label {
    margin: 0;
    font-size: var(--fs-body-lg);  /* 17 — Global Tokens/Body/body-lg */
    line-height: var(--lh-body-lg);
    color: var(--gray-50);
  }
  .ft__value {
    margin: 0;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--slate-50);
    white-space: pre-line;         /* giữ chỗ xuống dòng trong địa chỉ */
  }
  .ft__block--contact .ft__value { white-space: nowrap; }
  .ft__value a {
    color: inherit;
    text-decoration: none;
  }
  .ft__value a:hover { text-decoration: underline; }
  .ft__value a:focus-visible {
    outline: 2px solid var(--gray-50);
    outline-offset: 2px;
    border-radius: var(--r-xs);
  }

  /* --- Đường kẻ ---------------------------------------------------------
     Figma vẽ bằng một SVG `Line 1` cao 0, nét 1px. Ở đây dùng viền trên của
     <hr> — cùng kết quả, không thêm file. Màu `--gray-900` (#373737). */
  .ft__line {
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--gray-900);
  }

  /* --- Dòng cuối -------------------------------------------------------- */
  .ft__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-6);
    word-break: break-word;
  }
  .ft__legal p {
    margin: 0;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--gray-50);
    white-space: nowrap;
  }

  /* =====================================================================
     MOBILE < 768 — khác desktop/tablet ở ba chỗ
     ===================================================================== */
  @media (max-width: 767px) {
    .ft { padding: var(--s-10) var(--s-6); }      /* lề ngang 24 */

    /* Hoạ tiết tụt lên 32px — Dev Mode: `top-[-32px]`. */
    .ft__planet { top: -32px; }

    /* Bản vẽ mobile đảo thứ tự: Liên hệ lên trước, Địa chỉ xuống sau.
       Dùng `order` thay vì đảo thứ tự trong HTML, để trình đọc màn hình vẫn
       đọc theo mạch "địa chỉ rồi liên hệ" như bản desktop. */
    .ft__details {
      flex-direction: column;
      justify-content: space-between;
      gap: var(--s-3);                            /* Figma cao 165 → khe ≈ 12 */
    }
    .ft__block--contact {
      order: -1;
      align-items: flex-start;
      text-align: left;
    }
    .ft__legal {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-3);                            /* Dev Mode: gap 12 */
    }
    .ft__by { order: -1; }                        /* "Design by" lên trước */
  }

  /* =====================================================================
     TABLET ≥ 768 — chữ BAIKA 220 ở khổ 768, đặt cách đỉnh 46
     ===================================================================== */
  @media (min-width: 768px) {
    .ft__wordmark {
      font-size: 28.6vw;
      top: 46px;
    }
  }

  /* =====================================================================
     DESKTOP ≥ 1280 — chữ BAIKA 358 ở khổ 1280, bám đỉnh
     Chặn trần 358 để màn siêu rộng không phóng chữ to vô tội vạ.
     ===================================================================== */
  @media (min-width: 1280px) {
    .ft__wordmark {
      font-size: min(28vw, 358px);
      top: 0;
    }
  }

