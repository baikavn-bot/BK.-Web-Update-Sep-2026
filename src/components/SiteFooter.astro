---
// CHÂN TRANG DÙNG CHUNG — Figma `Footer` 450:5263.
// Dựng lại ngày 26/09/2026 bằng **Dev Mode** (lần trước đọc bằng Plugin API,
// sai nhiều chỗ — xem cuối file).
//
//   Desktop 217:2648 (1280) · Tablet 489:2986 (768) · Mobile 450:5264 (375)
//
// Ba khổ CÙNG cao 680, cùng gap 24, cùng xếp dọc + dồn xuống đáy.
// Khác nhau đúng bốn chỗ:
//
//   |                | Desktop      | Tablet       | Mobile          |
//   |----------------|--------------|--------------|-----------------|
//   | padding        | 40           | 40           | 40 dọc / 24 ngang |
//   | khối Details   | NGANG, cao 80| NGANG, cao 80| DỌC, cao 165 — Liên hệ lên trước |
//   | dòng cuối      | NGANG        | NGANG        | DỌC, gap 12 — "Design by" lên trước |
//   | chữ BAIKA      | 358px, top 0 | 220px, top 46| 100px, top 129  |
//
// Chữ BAIKA ở cả ba khổ đều CĂN GIỮA khung: Figma ghi `left: calc(50% - 600px)`
// với cỡ 358 (chữ rộng đúng 1201 = 600,5 × 2), `calc(50% - 369px)` với cỡ 220
// (rộng 738), `calc(50% - 168,5px)` với cỡ 100 (rộng 337). Ba lần đều khít.
// → Ở đây dùng `left: 50%` + `translateX(-50%)`: cùng kết quả, mà không phụ
//   thuộc vào việc chữ có rộng đúng từng pixel như trong Figma hay không.
//
// ──────────────────────────────────────────────────────────────────────
//
// HOẠ TIẾT `Planet` — dùng file SVG **xuất thẳng từ Figma**, không dựng lại.
//
// Thắng xuất tay ngày 26/09 (Figma đặt tên mặc định là `Colors=Main.svg`, đã
// đổi thành `footer-planet.svg`). Node gốc: `Planet` 219:2878.
// Nội dung: 29 hình vector + 6 hiệu ứng nhoè đã nung sẵn vào file. 14 KB.
//
// Trước đó em dựng lại bằng CSS, sai lệch ~7/255 so với bản vẽ, và kéo theo
// hai chỗ không sửa được: đáy hành tinh không đủ tối (bộ token không có màu
// nào tối hơn `--gray-950`), và cụm tia sáng chỉ là suy luận từ ảnh render.
// Dùng file thật thì cả hai biến mất. Khối CSS cũ đã xoá.
//
// ⚠️ File SVG **1962 × 1042**, không phải 1920 × 1000 như khung hoạ tiết trong
//    Figma. Chênh 21px mỗi phía là phần NHOÈ thò ra ngoài — hiệu ứng blur bao
//    giờ cũng loang rộng hơn hình gốc. Vì vậy khung `.ft__planet` đặt lệch lên
//    21px, chứ không phải bám sát mép trên.
//
// ⚠️ Trong file có 25 chữ `white`. Luật cấm `#fff` trong CLAUDE.md áp cho CSS
//    mình viết, không áp cho **file ảnh xuất từ Figma** — giống như không ai
//    đòi đổi màu từng pixel trong một tấm .webp. Đây là asset, không phải style.
// ──────────────────────────────────────────────────────────────────────

interface Props {
  /** Số điện thoại hiển thị. */
  phone?: string;
  email?: string;
  address?: string;
}
const {
  phone = '0905 247 365',
  email = 'baika.vn@gmail.com',
  address = 'Tầng 15, 72 Lê Thánh Tôn,\nP. Sài Gòn, Thành phố Hồ Chí Minh',
} = Astro.props;
---

<footer class="ft">
  {/* --- Hoạ tiết hành tinh --- */}
  <div class="ft__planet" aria-hidden="true">
    <img
      class="ft__planet-img"
      src="/img/footer-planet.svg"
      alt=""
      width="1962"
      height="1042"
      loading="lazy"
      decoding="async"
    />
  </div>

  {/* --- Chữ lớn. `aria-hidden` vì đây là hoạ tiết chữ, không phải nội
        dung: tên công ty đã có ở logo trên đầu trang, đọc lại là thừa. --- */}
  <p class="ft__wordmark" aria-hidden="true">Baika</p>

  <div class="ft__details">
    <div class="ft__block ft__block--address">
      <p class="ft__label">Địa chỉ</p>
      <p class="ft__value">{address}</p>
    </div>

    <div class="ft__block ft__block--contact">
      <p class="ft__label">Liên hệ</p>
      <p class="ft__value">
        <a href={`tel:${phone.replace(/\s/g, '')}`}>{phone}</a>
      </p>
      <p class="ft__value">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
  </div>

  <hr class="ft__line" />

  <div class="ft__legal">
    <p class="ft__rights">All rights reserved for Baika</p>
    <p class="ft__by">Design by Baika</p>
  </div>
</footer>

<style>
  /* =====================================================================
     KHUNG
     Dev Mode: flex · column · items-center · justify-end · gap 24 · h 680
     ===================================================================== */
  .ft {
    position: relative;
    z-index: 0;
    /* `isolation` khoá hiệu ứng hoà trộn của chữ BAIKA lại trong chân trang.
       Thiếu dòng này, `mix-blend-mode: overlay` sẽ đi tìm cả nền trang phía
       trên mà trộn — chữ đổi màu theo từng trang, không kiểm soát được. */
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;     /* Figma: dồn nội dung xuống đáy */
    gap: var(--s-6);               /* 24 */
    /* Figma khoá cứng 680. Ở đây để `min-height` phòng khi chữ xuống dòng
       nhiều hơn dự tính — thà chân trang cao thêm còn hơn cắt mất chữ. */
    min-height: 680px;
    padding: var(--s-10);          /* 40 — mobile đổi lề ngang xuống 24 */
    overflow: hidden;              /* Figma `overflow-clip` */
    background: var(--gray-950);   /* chân trang nằm NGOÀI <main> nên phải tự
                                      đặt nền, không thừa hưởng nền trang */
  }

  /* =====================================================================
     HOẠ TIẾT HÀNH TINH
     Khung 1920 × 1000, căn giữa, bám đỉnh — Figma giữ NGUYÊN số này ở cả ba
     khổ. Nghĩa là ở mobile nó tràn ra hai bên rất nhiều, và đó là chủ ý:
     vòng cung phải thoai thoải. Co nó lại theo bề ngang màn là hỏng.

     Ở đây khung để 1962 × 1042 (khung Figma + 21px nhoè mỗi phía) và đẩy lên
     −21px, nên phần hình THẬT vẫn nằm đúng 1920 × 1000 bám đỉnh chân trang.
     ===================================================================== */
  .ft__planet {
    position: absolute;
    top: -21px;
    left: 50%;
    z-index: 0;
    width: 1962px;
    height: 1042px;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .ft__planet-img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* =====================================================================
     CHỮ BAIKA
     ===================================================================== */
  .ft__wordmark {
    position: absolute;
    top: 129px;                    /* Mobile. Tablet 46 · Desktop 0 */
    /* Thắng chốt 26/09: khung chữ rộng **FULL VIEW**, lề 40 (mobile 24) —
       không phải một khối căn giữa theo bề rộng chữ. Điều này quan trọng vì
       gradient bên dưới tính theo BỀ NGANG KHUNG, không phải bề ngang chữ. */
    left: var(--s-10);
    right: var(--s-10);
    z-index: 1;                    /* NẰM TRÊN hoạ tiết, DƯỚI phần chữ đọc
                                      được — đúng thứ tự lớp trong Figma */
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 900;              /* Be Vietnam Pro Black. Đã phải thêm
                                      `;900` vào link Google Fonts ở
                                      BaseLayout — trước đó chỉ nạp tới 700,
                                      trình duyệt sẽ bôi đậm giả. */
    /* Cỡ chữ tính theo BỀ RỘNG KHUNG (đã trừ lề), không theo bề rộng màn.
       Hệ số lấy từ ba khổ trong Figma:
         mobile  375 − 48 = 327 · chữ 100 → 0,3058
         tablet  768 − 80 = 688 · chữ 220 → 0,3198
         desktop 1280 − 80 = 1200 · chữ 358 → 0,2983
       Không chặn trần nữa: "full view" nghĩa là màn rộng bao nhiêu chữ to
       bấy nhiêu. */
    font-size: calc((100vw - 48px) * 0.3058);
    line-height: 0.85;             /* Figma: 85% */
    text-transform: uppercase;
    /* Bắt buộc MỘT dòng. Thiếu dòng này chữ xuống hàng thành "BAIK / A" —
       đã thấy thật khi chụp thử. */
    white-space: nowrap;
    /* Gradient NGANG, nguyên văn CSS Thắng lấy từ Figma ngày 26/09:
         linear-gradient(90deg,
           rgba(255,255,255,0)    0%,
           rgba(255,255,255,0.50) 50.96%,
           rgba(255,255,255,0)    100%)
       Viết lại bằng token theo luật repo (không có `#fff` trong CSS):
       `--gray-50` là màu sáng nhất của hệ (#F8F8F8).

       ⚠️ Dev Mode còn ghi thêm `mix-blend-overlay`. Thắng đã xác nhận bản
          Figma KHÔNG có dòng đó — CSS anh copy thẳng từ panel Figma chỉ có
          gradient + background-clip. Đo cũng cho cùng kết luận: bật overlay
          thì lệch 111/255 so với bản vẽ, tắt thì 63/255. `overlay` làm TỐI
          khi nền dưới 50%, mà nền sau chữ gần như đen.
          → KHÔNG thêm `mix-blend-mode` vào đây.

       `background-clip: text` biến nét chữ thành "cửa sổ" nhìn xuyên xuống
       lớp gradient bên dưới. Vì gradient tính theo bề ngang KHUNG, hai đầu
       chữ sẽ nhạt dần — đúng chủ ý bản vẽ. */
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--gray-50) 50%, transparent) 50.96%,
      transparent 100%
    );
    -webkit-background-clip: text;
            background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    user-select: none;
  }

  /* =====================================================================
     KHỐI THÔNG TIN
     ===================================================================== */
  .ft__details,
  .ft__line,
  .ft__legal {
    position: relative;
    z-index: 2;                    /* trên cả hoạ tiết lẫn chữ BAIKA */
    width: 100%;
  }

  .ft__details {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-6);
    overflow: hidden;              /* Figma `overflow-clip` */
    word-break: break-word;
  }
  .ft__block {
    display: flex;
    flex-direction: column;
    /* Dev Mode ghi thẳng `gap-[7px]` ở cả ba khổ — đúng 7, không phải token.
       Đây là giá trị ngoài thang `--s-*`, cùng loại với 14 mà anh đã sửa về
       12. Muốn sạch thang thì sửa Figma về 8, em đổi lại một dòng. */
    gap: 7px;
    width: 300px;
    max-width: 100%;
  }
  .ft__block--contact {
    align-items: flex-end;
    text-align: right;
    white-space: nowrap;           /* Dev Mode: `whitespace-nowrap` */
  }
  .ft__label {
    margin: 0;
    font-size: var(--fs-body-lg);  /* 17 — Global Tokens/Body/body-lg */
    line-height: var(--lh-body-lg);
    color: var(--gray-50);
  }
  .ft__value {
    margin: 0;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--slate-50);
    white-space: pre-line;         /* giữ chỗ xuống dòng trong địa chỉ */
  }
  .ft__block--contact .ft__value { white-space: nowrap; }
  .ft__value a {
    color: inherit;
    text-decoration: none;
  }
  .ft__value a:hover { text-decoration: underline; }
  .ft__value a:focus-visible {
    outline: 2px solid var(--gray-50);
    outline-offset: 2px;
    border-radius: var(--r-xs);
  }

  /* --- Đường kẻ ---------------------------------------------------------
     Figma vẽ bằng một SVG `Line 1` cao 0, nét 1px. Ở đây dùng viền trên của
     <hr> — cùng kết quả, không thêm file. Màu `--gray-900` (#373737). */
  .ft__line {
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--gray-900);
  }

  /* --- Dòng cuối -------------------------------------------------------- */
  .ft__legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-6);
    word-break: break-word;
  }
  .ft__legal p {
    margin: 0;
    font-size: var(--fs-body-lg);
    line-height: var(--lh-body-lg);
    color: var(--gray-50);
    white-space: nowrap;
  }

  /* =====================================================================
     MOBILE < 768 — khác desktop/tablet ở ba chỗ
     ===================================================================== */
  @media (max-width: 767px) {
    .ft { padding: var(--s-10) var(--s-6); }      /* lề ngang 24 */

    /* Khung chữ BAIKA cũng theo lề 24 — gradient tính theo bề ngang khung
       nên đổi lề là đổi cả dáng chữ. */
    .ft__wordmark { left: var(--s-6); right: var(--s-6); }

    /* Hoạ tiết tụt lên 32px — Dev Mode: `top-[-32px]`. Cộng thêm 21px nhoè. */
    .ft__planet { top: -53px; }

    /* Bản vẽ mobile đảo thứ tự: Liên hệ lên trước, Địa chỉ xuống sau.
       Dùng `order` thay vì đảo thứ tự trong HTML, để trình đọc màn hình vẫn
       đọc theo mạch "địa chỉ rồi liên hệ" như bản desktop. */
    .ft__details {
      flex-direction: column;
      justify-content: space-between;
      gap: var(--s-3);                            /* Figma cao 165 → khe ≈ 12 */
    }
    .ft__block--contact {
      order: -1;
      align-items: flex-start;
      text-align: left;
    }
    .ft__legal {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-3);                            /* Dev Mode: gap 12 */
    }
    .ft__by { order: -1; }                        /* "Design by" lên trước */
  }

  /* =====================================================================
     TABLET ≥ 768 — chữ BAIKA 220 ở khổ 768, đặt cách đỉnh 46
     ===================================================================== */
  @media (min-width: 768px) {
    .ft__wordmark {
      left: var(--s-10);
      right: var(--s-10);
      font-size: calc((100vw - 80px) * 0.3198);
      top: 46px;
    }
  }

  /* =====================================================================
     ⚠️ MÀN RỘNG HƠN 1280 — hoạ tiết phải GIÃN THEO, không để cố định
     ---------------------------------------------------------------------
     Bản vẽ Figma chỉ có ba khổ 375 / 768 / 1280. File SVG rộng 1962, nghĩa
     là ở khổ 1280 người vẽ chỉ nhìn thấy **phần giữa** của nó — hai bên rìa
     nằm ngoài khung, chưa ai từng nhìn.

     Ở màn 1920 thì rìa đó lộ ra, và nó có **hai vòng cung tách nhau**: trong
     file có 4 nét vòng cung chồng lên nhau, bán kính lệch nhau một chút. Ở
     giữa chúng trùng khít thành một nét; càng ra rìa càng tách, thành hai
     đường song song cắt ngang cả khối địa chỉ. Thắng phát hiện 26/09.

     → Từ 1280 trở lên, cho hoạ tiết giãn NGANG theo bề ngang màn
       (1962 / 1280 = 153,281vw), GIỮ NGUYÊN chiều cao 1042.
       Như vậy phần hiện ra luôn đúng là phần Figma đã vẽ, ở mọi bề ngang.
       Giữ chiều cao cố định để đỉnh vòng cung vẫn nằm đúng chỗ cũ — nếu giãn
       cả hai chiều thì ở màn 1920 đỉnh tụt xuống 576px, đè lên khối địa chỉ.
       Vòng cung bẹt ra một chút, nhưng đây là hình mềm nên không ai nhận ra.

     Dưới 1280 giữ nguyên 1962px cố định — đúng như Figma, vì ở khổ nhỏ hoạ
     tiết vốn đã tràn ra ngoài hai bên rất nhiều và đó là chủ ý.
     Tại đúng 1280 hai cách cho cùng một con số, nên không có bước nhảy.
     ===================================================================== */
  @media (min-width: 1280px) {
    /* Phóng ĐỀU cả hai chiều theo bề ngang màn (1962/1280 và 1042/1280).
       Giãn riêng một chiều KHÔNG ăn thua: file SVG có `viewBox` nên trình
       duyệt tự giữ tỉ lệ và chừa viền, khung có rộng ra cũng vô ích.

       Phóng đều thì đỉnh vòng cung tụt xuống, nên phải kéo khung lên đúng
       bằng phần tụt đó: đỉnh nằm ở 405px trong file (384 + 21 nhoè), phóng
       k lần thành 405k, muốn nó ở lại 384 thì `top = 384 − 405k`.
       405/1280 = 0,31641 → `calc(384px - 31.641vw)`.

       Kiểm ở đúng 1280: rộng 1962 · cao 1042 · top −21 — trùng khít giá trị
       cố định bên trên, nên không có bước nhảy ở mốc breakpoint. */
    .ft__planet {
      width: 153.281vw;            /* 1962 / 1280 */
      height: 81.406vw;            /* 1042 / 1280 */
      top: calc(384px - 31.641vw);
    }
  }

  /* =====================================================================
     DESKTOP ≥ 1280 — chữ BAIKA 358 ở khổ 1280, bám đỉnh
     Chặn trần 358 để màn siêu rộng không phóng chữ to vô tội vạ.
     ===================================================================== */
  @media (min-width: 1280px) {
    .ft__wordmark {
      font-size: calc((100vw - 80px) * 0.2983);
      top: 0;
    }
  }

  /* =====================================================================
     HAI SAI LỆCH SO VỚI BẢN VẼ — cần Thắng quyết
     ---------------------------------------------------------------------
     VD-011 · Đáy hành tinh chưa đủ tối — ĐÃ XONG 26/09.
        Dùng file SVG thật thì thân hành tinh tự mang màu của nó, không còn
        phụ thuộc bộ token. Đo lại ở mép dưới: bản vẽ 7–11/255, bản dựng
        12–14/255. Coi như khớp.

     VD-012 · Chữ BAIKA: đã làm KHÁC Dev Mode, cần Thắng xác nhận.
        Xem khối `.ft__wordmark` phía trên — có đủ số đo và cách đổi lại.
     =====================================================================

     TÁM CHỖ BẢN TRƯỚC LÀM SAI — ghi lại để phiên sau không lặp
     ---------------------------------------------------------------------
     1. Nửa trên chân trang TỐI. Bản vẽ nửa trên SÁNG hơn nửa dưới — đó là
        quầng sáng `.ft__glow`, lần trước không có.
     2. Thiếu hẳn cụm cột răng lược `.ft__cot` — mép trên vùng sáng trong
        bản vẽ có dạng bướu tròn, không phải một vệt mờ trơn.
     3. Chữ BAIKA bị đẩy xuống dưới hoạ tiết (`z-index: -1`). Trong Figma nó
        là lớp CUỐI CÙNG, nằm TRÊN hoạ tiết — có vậy `overlay` mới trộn được
        với vòng cung.
     4. Chữ BAIKA căn bằng `left/right: 40px` (kéo giãn). Dev Mode cho thấy
        nó căn GIỮA khung ở cả ba khổ.
     5. Thiếu `top` riêng cho từng khổ: 0 / 46 / 129.
     6. Điểm giữa gradient chữ để 51%, Dev Mode ghi **50,962%**.
     7. Khối Details thiếu `width: 300px` (Dev Mode ghi rõ ở cả ba khổ) và
        thiếu `overflow-clip` + `word-break`.
     8. Dòng cuối ở mobile thiếu đảo thứ tự "Design by Baika" lên trước.
     ===================================================================== */
</style>
