---
// HEADER DÙNG CHUNG — Figma `NVG header` 452:6600 (component set, 6 biến thể).
// 🔴 05/10/2026 — DỰNG LẠI theo bản Thắng vẽ mới. Bản cũ (chỉ có hamburger,
//    cao 128) đã bỏ. Số đo đọc thẳng bằng Plugin API ngày 05/10.
//
// Cấu tạo
//   · Cao 96 · lề 24/40 (Desktop, Tablet) · 24/24 (Mobile) · logo trái, phần còn lại phải.
//   · ≥ 768 (Close Desktop 199:860 · Close Tablet 484:2505):
//       «Trạm ý tưởng» · «Trạm kết nối» · «Dịch vụ ⌄» · nút «Liên hệ» (Button 2 Sm)
//       Mỗi mục chữ: H-3, pad 0/12 (--s-3), cách nhau 12 (--s-3).
//   · Bấm «Dịch vụ» (Open Desktop 464:7012 · Open Tablet 484:2508): bảng
//       «Các dịch vụ» ngay dưới header, canh phải, rộng 768 (tablet = cả màn),
//       lưới 3 cột, gap 24, pad 24, nền --opacity-dark, có vệt sáng mờ trang trí.
//   · < 768 (Close Mobile 452:6601 · Open Mobile 472:4957): logo + hamburger 48;
//       bảng 1 cột phủ cả bề ngang.
//
// Thắng chốt 05/10:
//   · Remote Office ĐỨNG ĐẦU bảng dịch vụ ở mọi khổ (Figma Desktop/Tablet chưa có → đã thêm).
//   · Menu mobile thêm «Trạm ý tưởng», «Trạm kết nối», «Liên hệ».
//   · 2 Trạm: hiện chữ, CHƯA bấm được (chờ trang «Sắp ra mắt» — viec-cho #12).
//   · Bảng dịch vụ mở/đóng bằng BẤM (không phải rê chuột). Esc + bấm ra ngoài cũng đóng.
//
// Chỗ code KHÁC Figma (có chủ ý — đã ghi nhat-ky-figma-chung.md 05/10):
//   · Nút «Liên hệ» trong Figma đặt State=Focus (có quầng sáng). Code dùng trạng
//     thái thường; quầng sáng chỉ hiện khi focus bàn phím — Focus là trạng thái,
//     không phải kiểu trang trí (VD-005).
//   · Header Figma có Background blur PROGRESSIVE 100 → 0. Thang --blur-* không có
//     mức tương ứng (Figma 100 = CSS 50px) → CHƯA làm, chờ Thắng chốt.
//   · Vệt sáng trong bảng: Figma LayerBlur 82.5 → dùng --blur-80 (gần nhất).
//
// Logo: `Logo / Lockup` 861:8828 — public/img/logo/baika-lockup-white.svg (xuất
// thẳng từ Figma, màu trắng nằm trong file ảnh — ngoại lệ đã ghi từ 28/09).
import Button2 from './Button2.astro';

interface Props {
  /** Đường dẫn trang đang mở — để đánh dấu mục menu tương ứng. */
  current?: string;
  /** Logo trỏ về đâu. Landing ở tên miền riêng truyền URL baika.vn. */
  logoHref?: string;
}
const { current, logoHref = '/' } = Astro.props;

// 2 Trạm: chưa có trang đích → hiện chữ, không bấm được (không để link chết).
const tram = ['Trạm ý tưởng', 'Trạm kết nối'];

// Bảng dịch vụ — nguyên văn nhãn Figma. Slug từ DEC-019.
// Remote Office trỏ tên miền riêng của landing (Thắng chốt #13, 04/10).
const dichVu = [
  { label: 'Remote Office',            href: 'https://baika.website/' },
  { label: 'Đào tạo CEO',              href: '/ceo-blueprint' },
  { label: 'Pháp lý & Thuế',           href: '/legal-tax' },
  { label: 'Tư vấn doanh nghiệp',      href: '/advisory' },
  { label: 'Tài chính & Dòng tiền',    href: '/finance' },
  { label: 'Hệ thống hóa vận hành',    href: '/remote-ops' },
  { label: 'Marketing & Tăng trưởng',  href: '/marketing' },
  { label: 'Công nghệ & AI ứng dụng',  href: '/ai-os' },
];
---

<header class="hdr">
  <a class="hdr__logo" href={logoHref} aria-label="BAIKA — về trang chủ">
    <img src="/img/logo/baika-lockup-white.svg" alt="" width="130" height="48" />
  </a>

  {/* ===== ≥ 768: thanh điều hướng ===== */}
  <nav class="hdr__nav" aria-label="Menu chính">
    {tram.map((t) => <span class="hdr__muc hdr__muc--off">{t}</span>)}

    <button
      class="hdr__muc hdr__dv"
      type="button"
      aria-expanded="false"
      aria-controls="hdr-dichvu"
      data-mo="hdr-dichvu"
    >
      Dịch vụ
      <svg class="hdr__chev" width="24" height="24" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </button>

    <Button2 label="Liên hệ" href="/lien-he" size="sm" iconLeft={false} iconRight={false} />
  </nav>

  <div class="hdr__bang hdr__bang--dv" id="hdr-dichvu" hidden>
    <span class="hdr__vet" aria-hidden="true"></span>
    <ul class="hdr__luoi">
      {dichVu.map((m) => (
        <li>
          <a class="navbtn" href={m.href}
             aria-current={current === m.href ? 'page' : undefined}>{m.label}</a>
        </li>
      ))}
    </ul>
  </div>

  {/* ===== < 768: hamburger ===== */}
  <button
    class="hdr__toggle"
    type="button"
    aria-expanded="false"
    aria-controls="hdr-mobile"
    aria-label="Mở menu"
    data-mo="hdr-mobile"
  >
    {/* Hamburger · State=Close 3 gạch → State=Open 1 gạch. */}
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <line class="hdr__bar hdr__bar--1" x1="4" y1="6"  x2="20" y2="6" />
      <line class="hdr__bar hdr__bar--2" x1="4" y1="12" x2="20" y2="12" />
      <line class="hdr__bar hdr__bar--3" x1="4" y1="18" x2="20" y2="18" />
    </svg>
  </button>

  <nav class="hdr__bang hdr__bang--mb" id="hdr-mobile" hidden aria-label="Menu chính">
    <span class="hdr__vet" aria-hidden="true"></span>
    <ul class="hdr__luoi">
      {tram.map((t) => <li><span class="navbtn navbtn--off">{t}</span></li>)}
      {dichVu.map((m) => (
        <li>
          <a class="navbtn" href={m.href}
             aria-current={current === m.href ? 'page' : undefined}>{m.label}</a>
        </li>
      ))}
      <li class="hdr__lh">
        <Button2 label="Liên hệ" href="/lien-he" size="sm" iconLeft={false} iconRight={false} />
      </li>
    </ul>
  </nav>
</header>

<style>
  .hdr {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--s-6);          /* Mobile: lề 24 */
    background: none;               /* Figma: fill của khung đang ẨN → trong suốt */
    pointer-events: none;           /* chuột lọt xuống nội dung bên dưới */
  }
  .hdr > * { pointer-events: auto; }
  .hdr > [hidden] { display: none; }

  @media (min-width: 768px) {
    .hdr { padding: 0 var(--s-10); }   /* Desktop/Tablet: lề 40 */
  }

  /* --- Logo: Lockup 129×48 ở cả 3 khổ ------------------------------- */
  .hdr__logo {
    display: block;
    width: 130px;
    height: 48px;
    line-height: 0;
    border-radius: var(--r-xs);        /* chỉ để viền focus bo theo */
  }
  .hdr__logo img { width: 100%; height: 100%; display: block; }
  .hdr__logo:focus-visible { outline: 2px solid var(--gray-50); outline-offset: 3px; }

  /* --- Thanh điều hướng (≥ 768) -------------------------------------- */
  .hdr__nav { display: none; }
  @media (min-width: 768px) {
    .hdr__nav {
      display: flex;
      align-items: center;
      gap: var(--s-3);                 /* Figma 12 */
    }
  }

  /* Mục chữ — Figma: text style H-3, màu --gray-50, pad 0/12, icon cách 4. */
  .hdr__muc {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    padding: 0 var(--s-3);
    border: none;
    border-radius: var(--r-sm);
    background: none;
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: var(--fw-h3);
    color: var(--gray-50);
  }
  .hdr__muc--off { cursor: default; }
  .hdr__dv { cursor: pointer; }
  .hdr__dv:focus-visible { outline: none; box-shadow: var(--shadow-drop-inner); }
  /* Figma: Close dùng chevron-down, Open dùng chevron-up → ở đây xoay 180°. */
  .hdr__chev { transition: transform 160ms ease; }
  .hdr__dv[aria-expanded='true'] .hdr__chev { transform: rotate(180deg); }

  /* --- Nút hamburger (< 768) -----------------------------------------
     Figma 05/10: nền `Colors/Opacity/White` (--opacity-white, trắng 15%),
     nét --gray-50. Bo 8. */
  .hdr__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border: none;
    border-radius: var(--r-sm);
    background: var(--opacity-white);
    color: var(--gray-50);
    cursor: pointer;
  }
  .hdr__toggle:focus-visible { outline: none; box-shadow: var(--shadow-drop-inner); }
  @media (min-width: 768px) {
    .hdr__toggle, .hdr__bang--mb { display: none !important; }
  }
  @media (max-width: 767.98px) {
    .hdr__bang--dv { display: none !important; }
  }

  .hdr__bar { transition: opacity 160ms ease, transform 160ms ease; }
  .hdr__toggle[aria-expanded='true'] .hdr__bar--1 { transform: translateY(6px); opacity: 0; }
  .hdr__toggle[aria-expanded='true'] .hdr__bar--3 { transform: translateY(-6px); opacity: 0; }

  /* --- Bảng «Các dịch vụ» ---------------------------------------------
     Figma: ngay dưới header (y 96) · nền --opacity-dark · pad 24 · gap 24 ·
     cắt phần tràn. Desktop rộng 768 canh phải; Tablet/Mobile cả bề ngang. */
  .hdr__bang {
    position: absolute;
    top: 96px;
    right: 0;
    width: 100%;
    padding: var(--s-6);
    overflow: hidden;
    background: var(--opacity-dark);
  }
  @media (min-width: 769px) {
    .hdr__bang--dv { width: 768px; }
  }
  .hdr__bang--mb {
    max-height: calc(100dvh - 96px);   /* 11 mục cao hơn màn nhỏ → cuộn trong bảng */
    overflow-y: auto;
  }

  /* Vệt sáng trang trí — Figma `Vector 1` 388×471 tại (383, −6), gradient
     tuyến tính trong suốt → trắng, độ mờ 43%, LayerBlur 82.5 (≈ --blur-80). */
  .hdr__vet {
    position: absolute;
    top: -6px;
    left: 383px;
    width: 388px;
    height: 471px;
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--gray-50) 0%, transparent) 0%,
      var(--gray-50) 100%);
    opacity: 0.43;
    filter: blur(var(--blur-80));
    pointer-events: none;
  }
  .hdr__bang--mb .hdr__vet { left: -10px; }

  .hdr__luoi {
    position: relative;                 /* nổi trên vệt sáng */
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-6);                    /* 24 */
    justify-items: start;
  }
  .hdr__bang--dv .hdr__luoi { grid-template-columns: repeat(3, 1fr); }

  /* --- Mục menu — Figma `Nav Button` 472:4918 (05/10: chữ đổi sang H-3) - */
  .navbtn {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: var(--s-2);
    border-radius: var(--r-sm);
    font-family: var(--font-heading);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: var(--fw-h3);
    text-decoration: none;
    white-space: nowrap;
    color: var(--gray-600);
    transition: color 120ms ease, box-shadow 120ms ease;
  }
  .navbtn:hover  { color: var(--gray-50); }
  .navbtn:active { color: var(--gray-800); }
  /* Trang đang mở: cùng màu Focus, nhưng không có quầng sáng (VD-005). */
  .navbtn[aria-current='page'] { color: var(--gray-50); }
  .navbtn:focus-visible { outline: none; color: var(--gray-50); box-shadow: var(--shadow-drop-inner); }
  .navbtn--off { cursor: default; }
  .navbtn--off:hover { color: var(--gray-600); }

  /* Nút «Liên hệ» mobile: Figma đặt ở x 24, thẳng mép HỘP các mục trên. */

  @media (prefers-reduced-motion: reduce) {
    .hdr__bar, .hdr__chev { transition: none; }
  }
</style>

<script>
  // Mở/đóng 2 bảng (Dịch vụ ≥ 768 · menu mobile < 768). Không dùng thư viện.
  // Bấm nút để mở/đóng · Esc đóng và trả con trỏ về nút · bấm ra ngoài thì đóng.
  document.querySelectorAll<HTMLElement>('.hdr').forEach((hdr) => {
    const cap = [...hdr.querySelectorAll<HTMLButtonElement>('[data-mo]')]
      .map((btn) => ({ btn, bang: hdr.querySelector<HTMLElement>('#' + btn.dataset.mo) }))
      .filter((c): c is { btn: HTMLButtonElement; bang: HTMLElement } => !!c.bang);

    const dat = (c: (typeof cap)[number], mo: boolean) => {
      c.btn.setAttribute('aria-expanded', String(mo));
      c.bang.hidden = !mo;
      if (c.btn.classList.contains('hdr__toggle')) {
        c.btn.setAttribute('aria-label', mo ? 'Đóng menu' : 'Mở menu');
      }
    };

    cap.forEach((c) => {
      c.btn.addEventListener('click', () => {
        const mo = c.btn.getAttribute('aria-expanded') !== 'true';
        cap.forEach((k) => dat(k, false));
        dat(c, mo);
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      cap.forEach((c) => {
        if (c.btn.getAttribute('aria-expanded') === 'true') { dat(c, false); c.btn.focus(); }
      });
    });

    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      cap.forEach((c) => {
        if (c.btn.getAttribute('aria-expanded') === 'true'
            && !c.bang.contains(t) && !c.btn.contains(t)) dat(c, false);
      });
    });
  });
</script>
