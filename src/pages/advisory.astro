---
<ServicePageLayout
  title="Tư vấn doanh nghiệp — BAIKA"
  description="Dịch vụ tư vấn doanh nghiệp theo tư duy hệ thống: chẩn đoán đúng hiện trạng, thiết kế mô hình phù hợp và đồng hành triển khai."
  pillar="tu-van"
  current="/advisory"
>
  <HeroSection
    title="Tư vấn doanh nghiệp"
    tagline="Đồng hành cùng CEO từ chiến lược đến vận hành"
    lead="Dịch vụ tư vấn doanh nghiệp theo tư duy hệ thống: chẩn đoán đúng hiện trạng, thiết kế mô hình phù hợp và đồng hành triển khai — thay vì đưa lời khuyên chung chung."
  />
  <SolutionSection items={vanDe} />
  <BenefitsSection items={ketQua} />
  <PricingSection packages={goi} />
  <FaqSection items={cauHoi} />
  <ContactSection linhVuc={linhVuc} />
</ServicePageLayout>
