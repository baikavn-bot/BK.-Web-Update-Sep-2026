  { title: 'Đội ngũ chồng chéo',
    desc: 'Tuyển người nhưng không rõ vai trò; phòng ban chồng chéo; nhân sự giỏi đến rồi đi mà không rõ vì sao.' },
  { title: 'Tăng trưởng thiếu chiến lược',
    desc: 'Chạy theo cơ hội ngắn hạn; mở rộng nhưng lãi mỏng dần; không có bản đồ ưu tiên cho 12 tháng tới.' },
];

const ketQua = [
