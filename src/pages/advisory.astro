// Danh sách ô "Lĩnh vực" trong form — `claude/noi-dung-theo-section.md`, mục
// `S7 · Lĩnh vực (dropdown)`. **Mỗi trang một danh sách khác nhau**, nên nó
// nằm ở đây chứ không nằm cứng trong ContactSection.
const linhVuc = [
  'Mở doanh nghiệp mới',
  'Khám sức khỏe doanh nghiệp',
  'Cải thiện vận hành',
  'Tổ chức & nhân sự',
  'Chiến lược kinh doanh',
  'Tài chính – Pháp lý – Thuế',
  'Cố vấn CEO',
  'Chuyển đổi số',
  'Nhu cầu khác',
