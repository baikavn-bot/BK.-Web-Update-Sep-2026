  'Quy trình và vai trò được chuẩn hóa, giảm phụ thuộc cá nhân',
  'CEO thoát dần khỏi vận hành vụn để tập trung quyết định lớn',
  'Rủi ro tài chính – pháp lý – thuế được nhận diện sớm',
  'Có cố vấn đồng hành thay vì tự mò mẫm một mình',
];

const goi = [
  { eyebrow: 'Khởi đầu', title: 'Business Start',
    items: ['Định hình mô hình kinh doanh', 'Kiểm tra tính khả thi & điểm hòa vốn',
            'Lộ trình khởi động 90 ngày', 'Checklist pháp lý khi thành lập'] },
  { eyebrow: 'Đề xuất', title: 'Business Health Check', featured: true,
