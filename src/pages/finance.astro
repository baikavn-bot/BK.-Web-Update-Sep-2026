// Figma 3 gói, gói giữa `State=Focus` = đề xuất.
const goi = [
  { eyebrow: 'Kiểm tra', title: 'Finance Health Check',
    items: ['Đánh giá chất lượng số liệu & quy trình', 'Rà soát chứng từ & rủi ro thuế',
            'Báo cáo sức khỏe tài chính', 'Bản đồ ưu tiên hành động'] },
  { eyebrow: 'Hệ thống hóa', title: 'Finance Clean-Up & Control', featured: true,
    items: ['Accounting Clean-Up', 'Kiểm soát hóa đơn – chứng từ',
            'Quy trình tài chính & duyệt chi', 'Báo cáo quản trị + kiểm soát dòng tiền'] },
  { eyebrow: 'Hỗ trợ', title: 'Capital Readiness Program',
    items: ['Yêu cầu nền Clean-Up & Control', 'Chuẩn hóa hồ sơ tài chính thẩm định',
            'Mô hình số liệu trình nhà đầu tư', 'Đồng hành qua vòng thẩm định'] },
];

const cauHoi = [
  { question: 'BAIKA có thay thế kế toán của tôi không?',
    answer: 'Không. Kế toán của bạn vẫn vận hành hằng ngày; BAIKA chẩn đoán, thiết kế hệ thống, chuẩn hóa quy trình và nâng năng lực đội hiện có.' },
  { question: 'Sổ sách tôi đang rối, có làm được không?',
    answer: 'Đó chính là tình huống phổ biến nhất. Gói Clean-Up & Control sinh ra cho việc này — bắt đầu từ Health Check để đo mức độ trước.' },
  { question: 'Số liệu của tôi có được bảo mật?',
    answer: 'Có. Quyền truy cập phân theo vai trò, tài liệu trao đổi qua kênh kiểm soát và có điều khoản bảo mật trong hợp đồng.' },
  { question: 'Bao lâu thì gọi vốn được?',
    answer: 'Tùy nền hiện tại. Thông thường: Health Check 2–3 tuần, Clean-Up & Control 2–3 tháng, Capital Readiness thêm 1–2 tháng.' },
];

const linhVuc = [
  'Chẩn đoán sức khỏe tài chính',
  'Làm sạch sổ sách kế toán',
  'Kiểm soát hóa đơn – chứng từ',
  'Báo cáo quản trị cho CEO',
  'Kiểm soát dòng tiền',
  'Chuẩn bị vay vốn / gọi vốn',
  'Nhu cầu khác',
];
---
<ServicePageLayout
  title="Tài chính & Dòng tiền — BAIKA"
  description="Chẩn đoán, làm sạch, kiểm soát và nâng chuẩn hệ thống tài chính — để CEO ra quyết định bằng số liệu thật và doanh nghiệp sẵn sàng trước ngân hàng, nhà đầu tư."
  pillar="tai-chinh"
  current="/finance"
>
  <HeroSection
    title="Tài chính & Dòng tiền"
    tagline='Từ "sổ sách để đối phó" thành công cụ điều hành'
    lead="Chẩn đoán, làm sạch, kiểm soát và nâng chuẩn hệ thống tài chính — để CEO ra quyết định bằng số liệu thật và doanh nghiệp sẵn sàng trước ngân hàng, nhà đầu tư."
    ctaLabel="Bắt đầu Finance Assessment miễn phí"
  />
  <SolutionSection items={vanDe} />
  <StepsSection groups={baikaLamGi} />
  <BenefitsSection items={ketQua} />
  <PricingSection packages={goi} />
  <FaqSection items={cauHoi} />
  <ContactSection linhVuc={linhVuc} />
</ServicePageLayout>
