---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import BentoCard from '../components/BentoCard.astro';

// TRANG CHỦ — lưới bento một màn.
// Figma: section `Home` 540:4422 · Desktop 534:3816 · Tablet 540:4027 · Mobile 540:4115
//
// 9 ô có nhãn = 7 trang dịch vụ + Trạm Ý Tưởng + Trạm Kết Nối.
// Slug giữ nguyên từ site cũ — DEC-019.
//
// ⚠️ Hai ô CHƯA CÓ ĐÍCH: `Trạm Ý Tưởng` và `Trạm Kết Nối` đều ngoài phạm vi v1.
//    Để href = undefined → ô hiện bình thường nhưng KHÔNG bấm được.
//    Cố ý: thà không bấm được còn hơn link chết trả về 404.
const tiles = [
  { area: 'legal', label: 'PHÁP LÝ & THUẾ',              href: '/legal-tax' },
  { area: 'mkt',   label: 'MARKETING\nTĂNG TRƯỞNG',      href: '/marketing' },
  { area: 'ops',   label: 'HỆ THỐNG HÓA\nVẬN HÀNH',      href: '/remote-ops' },
  // Trạm Ý Tưởng dùng gradient RIÊNG — style `Hover BG 2` trong Figma
  // (instance 534:3833 ghi đè fillStyleId sang style đó). Tám ô còn lại
  // dùng `Hover BG Bento`.
  { area: 'idea',  label: 'TRẠM Ý TƯỞNG',                href: undefined, hoverStyle: 'bento-2' as const, featured: true },
  { area: 'conn',  label: 'TRẠM KẾT NỐI',                href: undefined },
  // Figma đặt ô này ở `State=Focus` — clipsContent=false nên gradient tràn
  // ra thành quầng sáng. Trạm Ý Tưởng ở `State=Hover` nên KHÔNG có quầng.
  { area: 'adv',   label: 'TƯ VẤN\nDOANH NGHIỆP',        href: '/advisory', featured: true, glow: true },
  { area: 'tech',  label: 'CÔNG NGHỆ\nAI ỨNG DỤNG',      href: '/ai-os' },
  { area: 'fin',   label: 'TÀI CHÍNH\nDÒNG TIỀN',        href: '/finance' },
  { area: 'ceo',   label: 'ĐÀO TẠO CEO',                 href: '/ceo-blueprint' },
];

// 6 ô rỗng chỉ có viền — nhịp thị giác của lưới, không mang nội dung.
const placeholders = ['ph1', 'ph2', 'ph3', 'ph4', 'ph5', 'ph6'];
---

<BaseLayout
  title="BAIKA — Tư vấn và kiến tạo hệ thống vận hành cho doanh nghiệp"
  description="BAIKA rà soát và dựng lại hệ thống vận hành — từ mô hình kinh doanh đến tài chính, pháp lý, công nghệ."
>
  <div class="stage">
    <div class="artwork" aria-hidden="true"></div>

    <div class="grid">
      <HomeHero area="hero" />
      {tiles.map((t) => (
        <BentoCard
          area={t.area}
          label={t.label}
          href={t.href}
          hoverStyle={t.hoverStyle}
          featured={t.featured}
          glow={t.glow}
        />
      ))}
      {placeholders.map((a) => <BentoCard variant="placeholder" area={a} />)}
      <BentoCard variant="empty" area="gap" />
    </div>
  </div>
</BaseLayout>

<script>
  // MOBILE — ô bento nào đang nằm giữa màn hình thì ô đó sáng.
  //
  // Thắng mô tả 25/09: màn nhỏ không có chuột nên không có trạng thái rê.
  // Thay vào đó, ô đi qua giữa màn hình sẽ sáng lên, ô trước đó tắt đi.
  //
  // Cách làm: IntersectionObserver với `rootMargin: -50% trên và dưới`.
  // Hai lề âm 50% thu vùng quan sát lại thành một ĐƯỜNG KẺ ngang giữa màn.
  // Ô nào chạm đường kẻ đó thì `isIntersecting = true`. Vì các ô xếp liền
  // nhau nên tại một thời điểm chỉ có đúng một ô chạm — không cần so sánh.
  //
  // Vì sao không dùng CSS thuần (`animation-timeline: view()`): tính năng
  // đó chưa chạy trên Safari, mà iPhone chiếm phần lớn lượt truy cập mobile.
  //
  // Không có JS thì mọi ô vẫn hiển thị ở trạng thái Default — mất hiệu ứng,
  // không hỏng trang.
  const mq = window.matchMedia('(max-width: 767px)');
  let observer: IntersectionObserver | null = null;

  function apply() {
    observer?.disconnect();
    observer = null;
    document
      .querySelectorAll('.tile--incenter')
      .forEach((el) => el.classList.remove('tile--incenter'));

    if (!mq.matches) return;

    observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          e.target.classList.toggle('tile--incenter', e.isIntersecting);
        }
      },
      { rootMargin: '-50% 0px -50% 0px', threshold: 0 },
    );

    document.querySelectorAll('.tile--card').forEach((el) => observer!.observe(el));
  }

  apply();
  mq.addEventListener('change', apply);
</script>

<style>
  .stage {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  /* --- Artwork nền — ẢNH XUẤT TỪ FIGMA --------------------------------
     Thắng xuất ngày 25/09: bản crop đúng khung Desktop 1280×832, scale 0.5x
     → 640×416. Em chuyển sang WebP: **2.9 KB**.

     Vì sao là ảnh chứ không phải CSS hay SVG:
     - Khối này gồm 5 lớp, 3 trong số đó là VECTOR (hình tự do vẽ tay).
       CSS chỉ có hình tròn và elip — không vẽ lại được hình tự do.
     - SVG dựng đúng hình nhưng cần 5 bộ lọc Gaussian 30–100px phủ kín
       màn hình → giật khi cuộn, tốn pin.
     - Ảnh đã "nướng" sẵn blur vào pixel, trình duyệt chỉ việc vẽ.

     Vì sao 640px là đủ cho màn 4K: cả khối là blur, KHÔNG có một chi tiết
     sắc nét nào để mất khi phóng to. Đây cũng là lý do 282 KB PNG nén
     xuống còn 2.9 KB WebP.

     KHÔNG thêm `filter: blur()` ở đây — blur đã nằm trong ảnh rồi. */
  .artwork {
    position: absolute;
    inset: 0;
    background-image: url('/img/home-bg.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    pointer-events: none;
  }

  /* --- Lưới bento ---------------------------------------------------
     Bố cục viết dưới dạng sơ đồ chữ: mỗi dòng là một hàng của lưới,
     mỗi tên là một ô. Nhìn là thấy layout, không phải đếm toạ độ.
     `gap` = ô trống hoàn toàn (không viền), Thắng chốt 24/09 là cố ý. */

  .grid {
    position: relative;
    display: grid;
    gap: 0;
  }

  /* --- MOBILE < 768 — một cột, CUỘN DỌC -------------------------------
     Đo Figma Mobile 540:4115: Grid Container 375×2288 = 11 hàng × 208,
     lề hai bên 24, ô rộng 327. Hero cao 416 = 2 hàng. 9 ô dịch vụ.

     Thứ tự đúng y Figma. Ô thứ 6 trong Figma KHÔNG có chữ — suy luận:
     đó chính là TRẠM Ý TƯỞNG, Thắng chưa gõ nhãn vào (đếm ra: 9 ô mobile,
     8 ô có chữ, thiếu đúng một cái là Trạm Ý Tưởng). Thắng đã xác nhận
     ô này phải có mặt ở cả 3 breakpoint → điền vào đúng chỗ đó.

     KHÔNG ép vừa một màn ở mobile: 11 hàng nhét vào một màn thì mỗi ô
     còn ~60px, chữ không đọc nổi. Mục tiêu "20 ô vừa một màn" là của
     lưới desktop. */
  .grid {
    width: 100%;
    /* KHÔNG khoá 375px: điện thoại thật rộng 390–430px, khoá lại thì
       hai bên hở ra hai dải trống. Để ô nở theo màn, giữ nguyên lề 24. */
    padding-inline: var(--s-6);
    grid-template-columns: 1fr;
    grid-auto-rows: 208px;
    grid-template-areas:
      'hero' 'hero'
      'adv' 'legal' 'ceo' 'conn' 'ops' 'idea' 'mkt' 'tech' 'fin';
  }

  /* Mobile không có ô rỗng nào — Figma cũng vậy. */
  .grid > :global(.tile--placeholder),
  .grid > :global(.tile--empty) { display: none; }

  /* --- TABLET 768–1279 — lưới LẤP ĐẦY MÀN HÌNH -------------------------
     Đo lại Figma Tablet 540:4027 ngày 25/09 (quét ĐỆ QUY — lần trước em
     chỉ quét con trực tiếp của Grid Container nên đếm thiếu một ô):
     768×832 = 3 cột × 4 hàng của ô 256×208, ĐỦ 9 ô dịch vụ, KHÔNG có ô rỗng. */
  @media (min-width: 768px) {
    .stage {
      height: 100svh;
      min-height: 0;
      place-items: stretch;
    }

    .grid {
      width: 100%;
      height: 100%;
      padding-inline: 0;
      grid-template-columns: repeat(3, 1fr);
      /* minmax: cửa sổ quá thấp thì ô ngừng co và trang cuộn,
         thay vì bóp ô đến mức chữ bị cắt. */
      grid-template-rows: repeat(4, minmax(120px, 1fr));
      grid-template-areas:
        'hero hero idea'
        'hero hero ceo'
        'ops  adv  mkt'
        'conn fin  legal';
    }

    /* CÔNG NGHỆ AI ỨNG DỤNG nằm ĐÈ lên góc dưới–phải của khối hero.
       Trong Figma nó là con của `Container` (khối hero), đặt tại (256,208)
       — nên khối hero thực chất là hình chữ L. `grid-template-areas` chỉ
       nhận vùng hình CHỮ NHẬT, không viết được chữ L, nên ô này phải đặt
       bằng số dòng/cột và chồng lên hero. Nó đứng sau hero trong DOM nên
       vẽ đè lên trên — đúng thứ tự lớp của Figma. */
    .grid > :global(.tile--at-tech) { grid-area: 2 / 2 / 3 / 3; }

    /* Tablet không có ô rỗng nào — giữ ẩn như ở mobile. */
  }

  /* --- DESKTOP ≥ 1280 — 5 cột × 4 hàng = 20 ô --------------------------
     Đo Figma Desktop 534:3816: Grid Container 1280×832, 16 node con
     (1 hero 512×416 + 15 ô 256×208). Bản đồ dưới đây đã đối chiếu từng
     toạ độ — KHỚP 100%, không sửa gì.

     Ô `gap` ở hàng 1 cột 3 trong Figma KHÔNG có node nào — trống thật,
     không viền, để lộ artwork nền. */
  @media (min-width: 1280px) {
    .grid {
      grid-template-columns: repeat(5, 1fr);
      grid-template-rows: repeat(4, minmax(140px, 1fr));
      grid-template-areas:
        'hero hero gap  legal ph1'
        'hero hero mkt  ph2   ops'
        'idea conn ph3  adv   ph4'
        'tech ph5  fin  ph6   ceo';
    }

    /* Desktop có bản đồ riêng cho tech — gỡ cách đặt thủ công của tablet. */
    .grid > :global(.tile--at-tech) { grid-area: tech; }

    .grid > :global(.tile--placeholder),
    .grid > :global(.tile--empty) { display: flex; }
  }
</style>
