---
// TRANG REMOTE OFFICE — landing riêng, domain `baika.website`
//
// ⚠️ CHƯA RA MẮT — nhánh `remote-office`. Thắng chốt 01/10: gắn baika.website vào
//    NHÁNH này trước (chưa gộp main), `noindex` vẫn BẬT tới khi sếp duyệt #5 #14.
//    Cách baika.website mở ra trang này: `vercel.json` ở gốc repo (xem chú thích ở
//    docs/remote-office/quy-trinh-build.md §5). `canonical` = https://baika.website/
//
// Nguồn: docs/remote-office/ — ĐỌC SPEC-MASTER.md TRƯỚC.
//   · Chữ, số           → docs/remote-office/spec-noi-dung.md
//   · Bố cục, component → docs/remote-office/spec-giao-dien.md
//   · Figma             → YmcXg1lQqGVjQOFrVtdOgW · frame 913:4649 (Desktop) · Tablet/Mobile của R2 R4 R6: spec-giao-dien §7
//                          (frame cũ 825:6535 đã được nhân bản sang đây 30/09 — đừng đọc bản cũ)
//
// Đã dựng — 6 khối dùng lại component của 7 trang dịch vụ:
//   R1 Hero · R3 BAIKA sẽ làm gì · R5 Bạn sẽ nhận được gì · R7 Các gói · R8 FAQ · R9 Liên hệ
// + 3 khối mới (01/10): R2 Chi phí thật (CostSection) · R4 Công cụ ước tính
//   (EstimatorSection + src/lib/uoc-tinh.ts) · R6 Bảng so sánh (CompareSection).
// Đủ 9/9 khối. Các chỗ TẠM chờ chốt: xem SPEC-MASTER §7.
//
// Luật lệch (SPEC-MASTER §3): chữ Figma ≠ spec nội dung → KHÔNG tự chọn,
// để trống + ghi `CHỜ CHỐT: Lx`. Thắng đã chốt L1–L13 ngày 30/09
// (spec-noi-dung §12); L14 còn chờ.
import ServicePageLayout from '../layouts/ServicePageLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import StepsSection from '../components/StepsSection.astro';
import CostSection from '../components/CostSection.astro';
import EstimatorSection from '../components/EstimatorSection.astro';
import BenefitsSection from '../components/BenefitsSection.astro';
import CompareSection from '../components/CompareSection.astro';
import PricingSection from '../components/PricingSection.astro';
import FaqSection from '../components/FaqSection.astro';
import ContactSection from '../components/ContactSection.astro';
import { SITE_CHINH } from '../lib/ten-mien';

// R2 — spec-noi-dung §2 ✅ (L1–L4). Dòng Tổng luôn CUỐI.
const chiPhi = [
  { nhan: 'Lương ghi trên hợp đồng',                  so: '10.000.000 đ' },
  { nhan: 'Bảo hiểm phần doanh nghiệp đóng (21,5%)',  so: '2.150.000 đ' },
  { nhan: 'Kinh phí công đoàn (2%)',                  so: '200.000 đ' },
  { nhan: 'Chỗ ngồi, thiết bị, tuyển dụng, ngày nghỉ', so: '1.500.000 đ – 2.500.000 đ' },
  { nhan: 'Tổng chi phí thật',                        so: '≈ 14 – 15 triệu/tháng', tong: true },
];
const ghiChuChiPhi = 'Số liệu minh hoạ cho một vị trí lương 10 triệu, con số thực tế tuỳ từng doanh nghiệp.';

// R3 — spec-noi-dung §3 ✅ (khớp Figma 913:4679 và spec cũ từng chữ)
const baikaLamGi = [
  { no: '01', title: 'Giấy tờ và con người', items: [
    { title: 'Hành chính – văn thư', desc: 'Nhận thư, trực điện thoại, soạn công văn, lưu trữ hồ sơ.' },
    { title: 'Nhân sự – tiền lương', desc: 'Bảng lương, khai bảo hiểm, thuế thu nhập cá nhân, hồ sơ nhân viên.' },
  ] },
  { no: '02', title: 'Sổ sách và tuân thủ', items: [
    { title: 'Kế toán – thuế', desc: 'Ghi sổ, tờ khai, báo cáo tài chính cùng đơn vị đủ điều kiện hành nghề.' },
    { title: 'Tuân thủ – quy chế', desc: 'Rà hồ sơ, soạn quy chế và biểu mẫu, nhắc hạn nộp báo cáo.' },
  ] },
  { no: '03', title: 'Khách hàng và bán hàng', items: [
    { title: 'Chăm sóc khách hàng', desc: 'Trực fanpage, Zalo OA, tin nhắn sàn, hotline theo ca.' },
    { title: 'Hỗ trợ kinh doanh', desc: 'Lập báo giá, nhập CRM, chăm khách tiềm năng, đối soát đơn.' },
  ] },
  { no: '04', title: 'Nội dung và số liệu', items: [
    { title: 'Nội dung – livestream', desc: 'Lịch nội dung, dựng clip ngắn, vận hành phiên livestream.' },
    { title: 'Số liệu – báo cáo', desc: 'Bảng số liệu hằng tuần về doanh thu, công nợ, nhân sự.' },
  ] },
];

// R5 — spec-noi-dung §5 ✅, đúng thứ tự Figma 913:4756
const ketQua = [
  'Không phải chấm công, quản lý',
  'Không phải tuyển thêm người',
  'Chi phí cố định hằng tháng',
  'Có hoá đơn VAT, tính chi phí được trừ',
  'Việc không đứt khi có người nghỉ',
  'Báo cáo hằng tháng, đổi gói theo tháng',
];

// R6 — spec-noi-dung §6 ✅ (L8 · L9 · L10 · L20). Figma: desktop 922:3801 ·
//      tablet 933:3544 · mobile 933:4613 (đề xuất D1, Thắng duyệt 01/10).
const soSanh = [
  { tieuChi: 'Chi phí mỗi tháng',          tuTuyen: '≈ 14–15 triệu cho một người',              baika: 'Từ 4,9 triệu' },
  { tieuChi: 'Bảo hiểm, công đoàn',        tuTuyen: 'Doanh nghiệp tự đóng, tăng theo mỗi người', baika: 'Đã nằm trong phí dịch vụ' },
  { tieuChi: 'Thời gian có người làm',     tuTuyen: 'Vài tuần tuyển, thêm thời gian thử việc',   baika: '7 ngày làm việc' },
  { tieuChi: 'Người nghỉ phép, nghỉ việc', tuTuyen: 'Việc dừng lại, phải tuyển lại',             baika: 'BAIKA bố trí người thay' },
  { tieuChi: 'Quản lý, chấm công',         tuTuyen: 'Doanh nghiệp tự làm',                       baika: 'Không cần' },
  { tieuChi: 'Chứng từ chi phí',           tuTuyen: 'Bảng lương, hồ sơ bảo hiểm',                baika: 'Hoá đơn VAT' },
];
// 🔒 Câu này gánh ranh giới BHXH (spec-noi-dung §10) — không bỏ.
const ghiChuSoSanh = 'Phần tiết kiệm đến từ việc không phải tuyển thêm người cho những việc BAIKA làm thay. Nghĩa vụ bảo hiểm với nhân viên bạn đang trực tiếp sử dụng vẫn giữ nguyên.';

// R7 — spec-noi-dung §7 ✅. Nhãn nhỏ = GIÁ (Thắng chốt 29/09, L11).
//      Giá đặt vào `eyebrow` có sẵn → không sửa component thẻ gói.
const goi = [
  { eyebrow: '4.900.000 đ/tháng', title: 'Khởi đầu',
    items: ['Gói nền đầy đủ', '1 nhóm việc', '40 đơn vị công việc', 'Báo cáo tháng'] },
  { eyebrow: '9.900.000 đ/tháng', title: 'Vận hành', featured: true,
    items: ['Gói nền đầy đủ', '3 nhóm việc', '100 đơn vị công việc', 'Họp rà soát mỗi quý'] },
  { eyebrow: '19.900.000 đ/tháng', title: 'Trọn gói',
    items: ['Gói nền đầy đủ', '5 nhóm việc', '220 đơn vị công việc', 'Ưu tiên thời gian trả kết quả'] },
];
const ghiChuGia = 'Giá chưa gồm VAT. Gói nền gồm cổng gửi yêu cầu, một điều phối viên phụ trách riêng, kho hồ sơ số và báo cáo tháng. Một đơn vị công việc tương đương một đầu việc chuẩn khoảng 30 phút.';

// R8 — spec-noi-dung §8 ✅ — 5 câu, khớp Figma 913:4830 (Thắng chốt L12 ngày 30/09).
//      Câu 1 🔒 bắt buộc giữ nguyên văn (ranh giới BHXH, spec-noi-dung §10).
const cauHoi = [
  { question: 'Dùng dịch vụ này thì doanh nghiệp có hết nghĩa vụ đóng BHXH không?',
    answer: 'Với nhân viên bạn đang trực tiếp sử dụng thì nghĩa vụ vẫn giữ nguyên. Cái bạn tiết kiệm được là không phải tuyển thêm người cho những việc BAIKA làm thay.' },
  { question: 'Tôi có được chỉ đạo trực tiếp người làm không?',
    answer: 'Bạn làm việc với điều phối viên và gửi yêu cầu qua cổng. BAIKA chọn người phù hợp và chịu trách nhiệm về kết quả, nhờ vậy dịch vụ không gián đoạn khi có người nghỉ.' },
  { question: 'Dùng hết đơn vị công việc trong tháng thì sao?',
    answer: 'BAIKA báo trước khi gần hết. Bạn mua thêm theo đơn giá của gói hoặc nâng gói từ tháng sau.' },
  { question: 'Dữ liệu công ty tôi được giữ thế nào?',
    answer: 'Hai bên ký cam kết bảo mật. Mỗi nhân sự chỉ truy cập phần dữ liệu cần cho việc mình làm, và mọi truy cập đều được ghi lại.' },
  { question: 'Bao lâu thì bắt đầu được?',
    answer: 'Trong 7 ngày làm việc sau khi ký hợp đồng.' },
];
---
<ServicePageLayout
  title="BAIKA Remote Office — thuê ngoài việc văn phòng từ 4,9 triệu/tháng"
  description="Giao việc hành chính, nhân sự, kế toán, chăm sóc khách hàng cho BAIKA. Không tuyển thêm người, không quản lý lao động, có hoá đơn VAT. Khảo sát miễn phí 45 phút."
  pillar="remote-office"
  canonical="https://baika.website/"
  noindex
  logoHref={`${SITE_CHINH}/`}
  current="https://baika.website/"
>
  {/* R1 — spec-noi-dung §1 ✅ */}
  <HeroSection
    title="Remote Office"
    tagline="Bộ phận văn phòng của bạn, không cần tuyển thêm người"
    lead="Giao việc hành chính, nhân sự, kế toán, chăm sóc khách hàng cho BAIKA. Bạn nhận kết quả đúng hạn, không phải tuyển người, không phải chấm công."
    ctaLabel="Ước tính chi phí miễn phí"
    ctaHref="#uoc-tinh"
  />

  {/* R2 — spec-noi-dung §2 ✅ · dựng 01/10. Cỡ chữ «23,5» TẠM 80px (Master §7 #10). */}
  <CostSection dong={chiPhi} note={ghiChuChiPhi} />

  {/* R3 — tiêu đề «BAIKA sẽ làm gì» = mặc định của component, đúng Figma (L5 chốt 30/09). */}
  <StepsSection groups={baikaLamGi} />

  {/* R4 — spec-noi-dung §4 · dựng 01/10. Neo #uoc-tinh (nút Hero trỏ tới) nằm trong khối.
      Danh sách tick nhóm việc = 8 mục của R3 ở trên (#4 chốt 01/10) — chữ chỉ nằm MỘT chỗ.
      ⏸ Đang chạy phương án TẠM cho Master §7 #5 #6 #14 — xem đầu EstimatorSection.astro. */}
  <EstimatorSection nhomViec={baikaLamGi.flatMap((cum) => cum.items.map((muc) => muc.title))} />

  {/* R5 — spec-noi-dung §5 ✅ */}
  <BenefitsSection items={ketQua} />

  {/* R6 — spec-giao-dien §5 + §7.3 ✅ (dựng 01/10) */}
  <CompareSection hang={soSanh} note={ghiChuSoSanh} />

  {/* R7 — spec-noi-dung §7 ✅ */}
  <PricingSection packages={goi} note={ghiChuGia} />

  {/* R8 */}
  <FaqSection items={cauHoi} />

  {/* R9 — nút «Đặt lịch khảo sát» (L13 chốt 30/09, khớp Figma I913:4868;26:2449).
      Ô "Lĩnh vực" (#12, Thắng chốt 04/10): TẠM dùng 8 trang — Remote Office + 7 trụ dịch vụ,
      chữ lấy đúng nhãn menu (SiteHeader). Danh sách chính thức sẽ chốt sau.
      Dòng pháp lý L14: ngay dưới form, không vào Footer chung (Thắng chốt 04/10). */}
  <ContactSection
    submitLabel="Đặt lịch khảo sát"
    linhVuc={[
      'Remote Office',
      'Đào tạo CEO',
      'Pháp lý & Thuế',
      'Tư vấn doanh nghiệp',
      'Tài chính & Dòng tiền',
      'Hệ thống hóa vận hành',
      'Marketing & Tăng trưởng',
      'Công nghệ & AI ứng dụng',
    ]}
    ghiChuPhapLy="Nội dung trên trang mang tính giới thiệu dịch vụ, không phải đề nghị giao kết hợp đồng. Điều khoản chính thức theo hợp đồng dịch vụ ký giữa hai bên."
  />
</ServicePageLayout>
