---
<ServicePageLayout
  title="Hệ thống hóa vận hành — BAIKA"
  description="Chuẩn hóa quy trình, sơ đồ tổ chức, task, KPI và báo cáo trên một nền tảng — để doanh nghiệp vận hành bằng hệ thống thay vì bằng trí nhớ của vài cá nhân."
  pillar="van-hanh"
  current="/remote-ops"
>
  <HeroSection
    title="Hệ thống hóa vận hành"
    tagline="Xây hệ điều hành doanh nghiệp — vận hành chuẩn"
    lead="Chuẩn hóa quy trình, sơ đồ tổ chức, task, KPI và báo cáo trên một nền tảng — để doanh nghiệp vận hành bằng hệ thống thay vì bằng trí nhớ của vài cá nhân."
    ctaLabel="Kiểm soát vận hành miễn phí"
  />
  <SolutionSection items={vanDe} />
  <StepsSection groups={baikaLamGi} />
  <BenefitsSection items={ketQua} />
  <PricingSection packages={goi} />
  <FaqSection items={cauHoi} />
  <ContactSection linhVuc={linhVuc} />
</ServicePageLayout>
