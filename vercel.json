{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/remote-office/?",
      "has": [
        {
          "type": "host",
          "value": "baika.website"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/(advisory|ai-os|ceo-blueprint|finance|legal-tax|lien-he|marketing|remote-ops)/?",
      "has": [
        {
          "type": "host",
          "value": "baika.website"
        }
      ],
      "status": 307,
      "headers": {
        "Location": "https://www.baika.tech/$1"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "baika.website"
        }
      ],
      "dest": "/remote-office/index.html"
    }
  ]
}
